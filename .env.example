# ─────────────────────────────────────────────────────────────────────────────
# AYAVA INTERN OS — environment template
# Copy to `.env` and fill in values. Never commit `.env`.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Database (PostgreSQL)
# Local: `npm run db:local` starts PostgreSQL on port 5433 with these defaults.
# Supabase: DATABASE_URL = pooled connection (port 6543, add ?pgbouncer=true),
#           DIRECT_URL   = direct connection (port 5432) used for migrations.
DATABASE_URL="postgresql://ayava:ayava-local-dev@localhost:5433/ayava_intern_os?schema=public"
DIRECT_URL="postgresql://ayava:ayava-local-dev@localhost:5433/ayava_intern_os?schema=public"

# Integration tests run against this database (it is reset by the test suite).
TEST_DATABASE_URL="postgresql://ayava:ayava-local-dev@localhost:5433/ayava_intern_os_test?schema=public"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Organization shown before multi-organization routing exists.
DEFAULT_ORGANIZATION_SLUG="ayava-creatives"

# Supabase Auth (required to sign in). All three are server-only: the app never
# creates a browser Supabase client, so none of them reach the browser.
# Supabase dashboard → Project Settings → API Keys. See docs/authentication.md.
# Newer projects show a "publishable" key (sb_publishable_…) and a "secret" key
# (sb_secret_…): use them here, or set SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY.
SUPABASE_URL=""
# Anon key or the newer publishable key:
SUPABASE_ANON_KEY=""
# Used to suspend accounts at the provider and to link seed accounts. Never expose.
# Service-role key or the newer secret key:
SUPABASE_SERVICE_ROLE_KEY=""

# Authentication policy
AUTH_REQUIRE_EMAIL_VERIFICATION="true"
AUTH_PASSWORD_MIN_LENGTH="10"
INVITATION_TTL_HOURS="168"

# Development seed: when set together with the Supabase service role key,
# `npm run db:seed` also creates matching Supabase Auth users with this
# password. Leave empty to seed profiles only. Never set in production.
SEED_DEV_PASSWORD=""

# File storage: "local" (development) or "supabase" (Prompt 05)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./.local/uploads"
STORAGE_MAX_UPLOAD_MB="10"

# AI (Prompt 07)
AI_PROVIDER=""
AI_API_KEY=""

# Invitation email. Without it, development shows the invitation link to the
# inviting admin once; production refuses to create invitations.
#   EMAIL_PROVIDER="smtp"    your own mail server (e.g. Hostinger: smtp.hostinger.com,
#                            port 465) — fill in the SMTP_* values below
#   EMAIL_PROVIDER="resend"  Resend API — set EMAIL_API_KEY
# EMAIL_FROM is the sender, e.g. "Ayava Intern OS <noreply@ayavacreatives.com>".
# Check the settings with: npm run email:test -- you@example.com
# (Password-reset and verification emails come from Supabase: set custom SMTP
# in Supabase → Authentication → Emails → SMTP Settings.)
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""
# SMTP_PORT: 465 = TLS, 587 = STARTTLS. SMTP_SECURE is optional (true on 465,
# false otherwise). SMTP_USER is usually the full mailbox address.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""

# Logging: debug | info | warn | error
LOG_LEVEL="info"

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret for POST /api/jobs/daily (ending-soon + overdue onboarding).
# Send as "Authorization: Bearer <secret>". At least 24 characters; jobs are
# disabled when unset. Locally you can run `npm run jobs:daily` instead.
CRON_SECRET=""
