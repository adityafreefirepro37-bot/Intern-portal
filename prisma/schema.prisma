  name        String
  slug        String   @unique
  logo_url    String?
  website_url String?
  description String?
  timezone    String   @default("Asia/Kolkata")
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  users                User[]
  roles                Role[]
  departments          Department[]
  teams                Team[]
  positions            Position[]
  interns              Intern[]
  internships          Internship[]
  internship_documents InternshipDocument[]
  onboarding_items     OnboardingItem[]
  projects             Project[]
  tasks                Task[]
  attendance           Attendance[]
  leave_types          LeaveType[]
  leave_requests       LeaveRequest[]
  courses              Course[]
  meetings             Meeting[]
  calendar_events      CalendarEvent[]
  feedback             Feedback[]
  performance_reviews  PerformanceReview[]
  announcements        Announcement[]
  notifications        Notification[]
  channels             Channel[]
  certificates         Certificate[]
  ai_conversations     AiConversation[]
  knowledge_documents  KnowledgeDocument[]
  audit_logs           AuditLog[]
  settings             Setting[]
  invitations          UserInvitation[]
  user_sessions        UserSession[]
  onboardings          Onboarding[]
  onboarding_templates OnboardingTemplate[]
  policies             Policy[]
  acknowledgements     DocumentAcknowledgement[]
  lifecycle_events     InternLifecycleEvent[]
  code_counters        CodeCounter[]

  project_attachments ProjectAttachment[]

  attendance_corrections AttendanceCorrection[]
  leave_balances         LeaveBalance[]
  document_types         HrDocumentType[]
  holidays               Holiday[]
  hr_requests            HrRequest[]
  offboarding_checklists OffboardingChecklist[]

  course_categories      CourseCategory[]
  course_enrollments     CourseEnrollment[]
  learning_paths         LearningPath[]
  learning_plans         LearningPlan[]
  required_training      RequiredTrainingRule[]
  assignment_submissions LearningAssignmentSubmission[]
  feedback_requests      FeedbackRequest[]
  weekly_checkins        WeeklyCheckin[]
  performance_goals      PerformanceGoal[]
  performance_templates  PerformanceTemplate[]
  performance_cycles     PerformanceCycle[]
  development_plans      DevelopmentPlan[]

  @@map("organizations")
}

/// Application user profile. Credentials live in the auth provider (Supabase
/// Auth); `auth_user_id` links to it. Never store passwords here.
model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String     @db.Uuid
  auth_user_id      String?    @unique @db.Uuid
  email             String
  first_name        String
  last_name         String
  display_name      String?
  avatar_url        String?
  phone             String?
  status            UserStatus @default(INVITED)
  timezone          String?
  last_login_at     DateTime?  @db.Timestamptz(3)
  /// Set when the auth provider confirms the email address.
  email_verified_at DateTime?  @db.Timestamptz(3)
  created_at        DateTime   @default(now()) @db.Timestamptz(3)
  updated_at        DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at        DateTime?  @db.Timestamptz(3)

  organization  Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user_roles    UserRole[]   @relation("UserRoles")
  roles_granted UserRole[]   @relation("RoleGrantedBy")

  intern                  Intern?
  interns_managed         Intern[]                  @relation("InternManager")
  interns_mentored        Intern[]                  @relation("InternMentor")
  internships_managed     Internship[]              @relation("InternshipManager")
  internships_mentored    Internship[]              @relation("InternshipMentor")
  departments_led         Department[]              @relation("DepartmentHead")
  teams_led               Team[]                    @relation("TeamLead")
  documents_uploaded      InternshipDocument[]
  onboarding_assigned     OnboardingItem[]          @relation("OnboardingAssignee")
  onboarding_completed    OnboardingItem[]          @relation("OnboardingCompleter")
  projects_owned          Project[]                 @relation("ProjectOwner")
  project_memberships     ProjectMember[]
  tasks_created           Task[]                    @relation("TaskCreator")
  task_assignments        TaskAssignee[]            @relation("TaskAssignee")
  task_assignments_made   TaskAssignee[]            @relation("TaskAssigner")
  task_comments           TaskComment[]
  task_attachments        TaskAttachment[]
  submissions             TaskSubmission[]          @relation("SubmissionAuthor")
  submissions_reviewed    TaskSubmission[]          @relation("SubmissionReviewer")
  submission_versions     SubmissionVersion[]
  attendance              Attendance[]
  corrections_requested   AttendanceCorrection[]    @relation("CorrectionRequester")
  corrections_reviewed    AttendanceCorrection[]    @relation("CorrectionReviewer")
  leave_requests          LeaveRequest[]            @relation("LeaveRequester")
  leave_reviews           LeaveRequest[]            @relation("LeaveReviewer")
  courses_created         Course[]                  @relation("CourseCreator")
  quiz_attempts           QuizAttempt[]
  learning_progress       LearningProgress[]
  meetings_created        Meeting[]
  calendar_events_created CalendarEvent[]
  feedback_given          Feedback[]                @relation("FeedbackFrom")
  feedback_received       Feedback[]                @relation("FeedbackTo")
  checkins_reviewed       WeeklyCheckin[]
  reviews_written         PerformanceReview[]       @relation("ReviewReviewer")
  announcements_published Announcement[]
  notifications           Notification[]
  channels_created        Channel[]
  messages_sent           Message[]
  ai_conversations        AiConversation[]
  knowledge_uploaded      KnowledgeDocument[]
  audit_logs              AuditLog[]
  invitations_sent        UserInvitation[]          @relation("InvitationCreator")
  invitations_revoked     UserInvitation[]          @relation("InvitationRevoker")
  invitation              UserInvitation[]          @relation("InvitationUser")
  sessions                UserSession[]
  onboardings_created     Onboarding[]
  templates_created       OnboardingTemplate[]
  template_items_assigned OnboardingTemplateItem[]
  policies_created        Policy[]
  acknowledgements        DocumentAcknowledgement[]
  lifecycle_events_acted  InternLifecycleEvent[]

  managed_projects       Project[]            @relation("ProjectManager")
  created_projects       Project[]            @relation("ProjectCreator")
  project_members_added  ProjectMember[]      @relation("ProjectMemberAdder")
  updated_tasks          Task[]               @relation("TaskUpdater")
  reviewed_versions      SubmissionVersion[]  @relation("VersionReviewer")
  comment_mentions       TaskCommentMention[] @relation("CommentMentions")
  completed_checklist    TaskChecklistItem[]  @relation("ChecklistCompleter")
  created_dependencies   TaskDependency[]     @relation("DependencyCreator")
  time_entries           TaskTimeEntry[]      @relation("TimeEntries")
  uploaded_project_files ProjectAttachment[]  @relation("ProjectFileUploader")

  attendance_updated      Attendance[]           @relation("AttendanceUpdater")
  attendance_corrections  AttendanceCorrection[] @relation("CorrectionSubject")
  leave_created           LeaveRequest[]         @relation("LeaveCreator")
  leave_cancelled         LeaveRequest[]         @relation("LeaveCanceller")
  leave_balances          LeaveBalance[]         @relation("LeaveBalanceOwner")
  leave_balances_updated  LeaveBalance[]         @relation("LeaveBalanceUpdater")
  documents_verified      InternshipDocument[]   @relation("DocumentVerifier")
  holidays_created        Holiday[]
  hr_requests             HrRequest[]            @relation("HrRequester")
  hr_requests_assigned    HrRequest[]            @relation("HrRequestAssignee")
  hr_requests_resolved    HrRequest[]            @relation("HrRequestResolver")
  hr_request_comments     HrRequestComment[]
  hr_request_attachments  HrRequestAttachment[]
  announcements_created   Announcement[]         @relation("AnnouncementCreator")
  offboardings_started    OffboardingChecklist[]
  offboarding_items_owned OffboardingItem[]      @relation("OffboardingAssignee")
  offboarding_items_done  OffboardingItem[]      @relation("OffboardingCompleter")

  courses_updated               Course[]                       @relation("CourseUpdater")
  enrollments                   CourseEnrollment[]             @relation("EnrollmentUser")
  enrollments_assigned          CourseEnrollment[]             @relation("EnrollmentAssigner")
  learning_paths_created        LearningPath[]
  learning_plans                LearningPlan[]                 @relation("PlanUser")
  learning_plans_assigned       LearningPlan[]                 @relation("PlanAssigner")
  required_training_created     RequiredTrainingRule[]
  assignment_submissions        LearningAssignmentSubmission[] @relation("AssignmentSubmitter")
  assignment_reviews            LearningAssignmentSubmission[] @relation("AssignmentReviewer")
  learning_versions_submitted   LearningSubmissionVersion[]    @relation("LearningVersionSubmitter")
  learning_versions_reviewed    LearningSubmissionVersion[]    @relation("LearningVersionReviewer")
  feedback_requests_made        FeedbackRequest[]              @relation("FeedbackRequester")
  feedback_requests_received    FeedbackRequest[]              @relation("FeedbackRequestRecipient")
  goals_owned                   PerformanceGoal[]              @relation("GoalOwner")
  goals_created                 PerformanceGoal[]              @relation("GoalCreator")
  goal_evidence_added           GoalEvidence[]
  performance_templates_created PerformanceTemplate[]
  performance_cycles_created    PerformanceCycle[]
  reviews_mentored              PerformanceReview[]            @relation("ReviewMentor")
  reviews_completed             PerformanceReview[]            @relation("ReviewCompleter")
  review_answers                PerformanceReviewAnswer[]
  review_revisions              PerformanceReviewRevision[]
  development_plans_created     DevelopmentPlan[]
  development_items_owned       DevelopmentPlanItem[]

  @@unique([organization_id, email])
  @@index([organization_id, status])
  @@index([email])
  @@map("users")
}

/// Roles are data, scoped per organization. System roles are seeded and
/// flagged `is_system_role`; organizations may add their own later.
model Role {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  slug            String
  description     String?
  is_system_role  Boolean  @default(false)
  /// Privilege rank. A user may only assign roles ranked below their own
  /// (super admins excepted), which prevents privilege escalation.
  rank            Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  role_permissions RolePermission[]
  user_roles       UserRole[]
  invitations      UserInvitation[]

  @@unique([organization_id, slug])
  @@index([organization_id])
  @@map("roles")
}

/// Global permission catalog in `resource.action` form.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String
  action      String
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(3)

  role_permissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  role_id       String          @db.Uuid
  permission_id String          @db.Uuid
  /// Which records the grant covers (own, assigned, team, department, organization).
  scope         PermissionScope @default(ORGANIZATION)
  created_at    DateTime        @default(now()) @db.Timestamptz(3)

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@map("role_permissions")
}

/// Assigns roles to users (a user may hold several roles).
model UserRole {
  user_id    String   @db.Uuid
  role_id    String   @db.Uuid
  granted_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)

  user    User  @relation("UserRoles", fields: [user_id], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [role_id], references: [id], onDelete: Restrict)
  granter User? @relation("RoleGrantedBy", fields: [granted_by], references: [id], onDelete: SetNull)

  @@id([user_id, role_id])
  @@index([role_id])
  @@map("user_roles")
}

/// Invitation to join an organization. Only a SHA-256 hash of the token is
/// stored; the raw token exists only in the invitation link.
model UserInvitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  user_id         String    @db.Uuid
  email           String
  role_id         String    @db.Uuid
  token_hash      String    @unique
  expires_at      DateTime  @db.Timestamptz(3)
  accepted_at     DateTime? @db.Timestamptz(3)
  revoked_at      DateTime? @db.Timestamptz(3)
  revoked_by      String?   @db.Uuid
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation("InvitationUser", fields: [user_id], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [role_id], references: [id], onDelete: Restrict)
  creator      User?        @relation("InvitationCreator", fields: [created_by], references: [id], onDelete: SetNull)
  revoker      User?        @relation("InvitationRevoker", fields: [revoked_by], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at(sort: Desc)])
  @@index([user_id])
  @@index([email])
  @@map("user_invitations")
}

/// Sessions observed by the application, keyed by the auth provider's
/// session id (JWT `session_id` claim). Used to list devices and to revoke
/// individual sessions: a revoked session is rejected on its next request.
model UserSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  user_id         String    @db.Uuid
  auth_session_id String    @unique @db.Uuid
  user_agent      String?
  ip_address      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  last_seen_at    DateTime  @default(now()) @db.Timestamptz(3)
  revoked_at      DateTime? @db.Timestamptz(3)
  revoked_reason  String?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at])
  @@map("user_sessions")
}

/// Fixed-window rate-limit counters. Stored in PostgreSQL so limits hold
/// across multiple application instances.
model RateLimitBucket {
  key      String   @id
  count    Int
  reset_at DateTime @db.Timestamptz(3)

  @@index([reset_at])
  @@map("rate_limit_buckets")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  slug            String
  description     String?
  head_user_id    String?  @db.Uuid
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization         Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  head                 User?                @relation("DepartmentHead", fields: [head_user_id], references: [id], onDelete: SetNull)
  teams                Team[]
  positions            Position[]
  interns              Intern[]
  internships          Internship[]
  onboarding_templates OnboardingTemplate[]

  learning_paths     LearningPath[]
  performance_cycles PerformanceCycle[]

  @@unique([organization_id, slug])
  @@index([organization_id])
  @@map("departments")
}

model Team {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  department_id   String?  @db.Uuid
  name            String
  slug            String
  description     String?
  team_lead_id    String?  @db.Uuid
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [department_id], references: [id], onDelete: SetNull)
  team_lead    User?        @relation("TeamLead", fields: [team_lead_id], references: [id], onDelete: SetNull)
  interns      Intern[]

  @@unique([organization_id, slug])
  @@index([organization_id])
  @@index([department_id])
  @@map("teams")
}

model Position {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  title           String
  slug            String
  description     String?
  department_id   String?  @db.Uuid
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization         Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  department           Department?          @relation(fields: [department_id], references: [id], onDelete: SetNull)
  interns              Intern[]
  internships          Internship[]
  onboarding_templates OnboardingTemplate[]

  learning_paths LearningPath[]

  @@unique([organization_id, slug])
  @@index([organization_id])
  @@index([department_id])
  @@map("positions")
}

// ─────────────────────────────────────────────────────────────────────────────
// INTERNS & INTERNSHIPS
// ─────────────────────────────────────────────────────────────────────────────

model Intern {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String       @db.Uuid
  user_id           String       @unique @db.Uuid
  employee_code     String
  status            InternStatus @default(SELECTED)
  joining_date      DateTime?    @db.Date
  expected_end_date DateTime?    @db.Date
  actual_end_date   DateTime?    @db.Date
  department_id     String?      @db.Uuid
  team_id           String?      @db.Uuid
  position_id       String?      @db.Uuid
  manager_id        String?      @db.Uuid
  mentor_id         String?      @db.Uuid
  created_at        DateTime     @default(now()) @db.Timestamptz(3)
  updated_at        DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at        DateTime?    @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [department_id], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [team_id], references: [id], onDelete: SetNull)
  position     Position?    @relation(fields: [position_id], references: [id], onDelete: SetNull)
  manager      User?        @relation("InternManager", fields: [manager_id], references: [id], onDelete: SetNull)
  mentor       User?        @relation("InternMentor", fields: [mentor_id], references: [id], onDelete: SetNull)

  profile             InternProfile?
  emergency_contacts  EmergencyContact[]
  internships         Internship[]
  documents           InternshipDocument[]
  feedback            Feedback[]
  weekly_checkins     WeeklyCheckin[]
  performance_reviews PerformanceReview[]
  certificates        Certificate[]
  lifecycle_events    InternLifecycleEvent[]
  offboarding         OffboardingChecklist?

  feedback_requests FeedbackRequest[]
  goals             PerformanceGoal[]
  development_plans DevelopmentPlan[]

  @@unique([organization_id, employee_code])
  @@index([organization_id, status])
  @@index([department_id])
  @@index([team_id])
  @@index([manager_id])
  @@index([mentor_id])
  @@map("interns")
}

/// Personal profile. Only data needed to run the internship is collected.
model InternProfile {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intern_id       String    @unique @db.Uuid
  preferred_name  String?
  date_of_birth   DateTime? @db.Date
  gender          String?
  address_line_1  String?
  address_line_2  String?
  city            String?
  state           String?
  postal_code     String?
  country         String?
  education_level String?
  institution     String?
  field_of_study  String?
  graduation_year Int?
  bio             String?
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  intern Intern @relation(fields: [intern_id], references: [id], onDelete: Cascade)

  @@map("intern_profiles")
}

model EmergencyContact {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intern_id       String   @db.Uuid
  name            String
  relationship    String
  phone           String
  alternate_phone String?
  email           String?
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  intern Intern @relation(fields: [intern_id], references: [id], onDelete: Cascade)

  @@index([intern_id])
  @@map("emergency_contacts")
}

/// A specific internship engagement (an intern may have more than one over time).
model Internship {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String           @db.Uuid
  intern_id         String           @db.Uuid
  title             String
  department_id     String?          @db.Uuid
  position_id       String?          @db.Uuid
  start_date        DateTime         @db.Date
  expected_end_date DateTime?        @db.Date
  actual_end_date   DateTime?        @db.Date
  status            InternshipStatus @default(PLANNED)
  work_mode         WorkMode         @default(REMOTE)
  location          String?
  manager_id        String?          @db.Uuid
  mentor_id         String?          @db.Uuid
  description       String?
  /// Compensation — readable only with compensation.read.
  stipend_amount    Decimal?         @db.Decimal(12, 2)
  stipend_currency  String?          @db.Char(3)
  stipend_frequency String?
  stipend_notes     String?
  created_at        DateTime         @default(now()) @db.Timestamptz(3)
  updated_at        DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  organization     Organization           @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern           Intern                 @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  department       Department?            @relation(fields: [department_id], references: [id], onDelete: SetNull)
  position         Position?              @relation(fields: [position_id], references: [id], onDelete: SetNull)
  manager          User?                  @relation("InternshipManager", fields: [manager_id], references: [id], onDelete: SetNull)
  mentor           User?                  @relation("InternshipMentor", fields: [mentor_id], references: [id], onDelete: SetNull)
  documents        InternshipDocument[]
  onboarding_items OnboardingItem[]
  onboarding       Onboarding?
  certificates     Certificate[]
  offboardings     OffboardingChecklist[]

  @@index([organization_id, status])
  @@index([intern_id])
  @@index([manager_id])
  @@index([mentor_id])
  @@map("internships")
}

model InternshipDocument {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String             @db.Uuid
  intern_id           String             @db.Uuid
  internship_id       String?            @db.Uuid
  document_type       DocumentType
  file_name           String
  storage_path        String
  mime_type           String
  file_size           Int
  uploaded_by         String?            @db.Uuid
  visibility          DocumentVisibility @default(HR)
  /// Configurable type (document_types); document_type stays as the legacy category.
  document_type_id    String?            @db.Uuid
  status              DocumentStatus     @default(UPLOADED)
  /// Versions are never overwritten: a replacement is a new row pointing at the previous one.
  version             Int                @default(1)
  previous_version_id String?            @db.Uuid
  is_current          Boolean            @default(true)
  verified_by         String?            @db.Uuid
  verified_at         DateTime?          @db.Timestamptz(3)
  rejection_reason    String?
  expires_at          DateTime?          @db.Date
  notes               String?
  created_at          DateTime           @default(now()) @db.Timestamptz(3)
  updated_at          DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at          DateTime?          @db.Timestamptz(3)

  organization     Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern           Intern               @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  internship       Internship?          @relation(fields: [internship_id], references: [id], onDelete: SetNull)
  uploader         User?                @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)
  onboarding_items OnboardingItem[]
  type             HrDocumentType?      @relation(fields: [document_type_id], references: [id], onDelete: SetNull)
  previous_version InternshipDocument?  @relation("DocumentVersions", fields: [previous_version_id], references: [id], onDelete: SetNull)
  next_versions    InternshipDocument[] @relation("DocumentVersions")
  verifier         User?                @relation("DocumentVerifier", fields: [verified_by], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([intern_id])
  @@index([internship_id])
  @@index([intern_id, document_type_id, is_current])
  @@index([organization_id, status])
  @@index([expires_at])
  @@map("internship_documents")
}

/// Configurable document requirements (per organization).
model HrDocumentType {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String             @db.Uuid
  name               String
  slug               String
  description        String?
  is_required        Boolean            @default(false)
  is_sensitive       Boolean            @default(false)
  has_expiry         Boolean            @default(false)
  legacy_type        DocumentType       @default(OTHER)
  default_visibility DocumentVisibility @default(HR)
  is_active          Boolean            @default(true)
  sort_order         Int                @default(0)
  created_at         DateTime           @default(now()) @db.Timestamptz(3)
  updated_at         DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  documents    InternshipDocument[]

  @@unique([organization_id, slug])
  @@map("document_types")
}

model OnboardingItem {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String                 @db.Uuid
  internship_id          String                 @db.Uuid
  title                  String
  description            String?
  item_type              OnboardingItemType     @default(TASK)
  required               Boolean                @default(true)
  status                 OnboardingItemStatus   @default(PENDING)
  due_date               DateTime?              @db.Date
  assigned_to            String?                @db.Uuid
  completed_at           DateTime?              @db.Timestamptz(3)
  completed_by           String?                @db.Uuid
  sort_order             Int                    @default(0)
  onboarding_id          String?                @db.Uuid
  /// Source template item (traceability only; the item is an independent snapshot).
  template_item_id       String?                @db.Uuid
  assigned_role          OnboardingAssigneeRole @default(INTERN)
  /// DOCUMENT items: the document type that satisfies the item, and the uploaded document.
  required_document_type DocumentType?
  document_id            String?                @db.Uuid
  /// ACKNOWLEDGEMENT items: the policy to acknowledge.
  policy_id              String?                @db.Uuid
  blocked_reason         String?
  created_at             DateTime               @default(now()) @db.Timestamptz(3)
  updated_at             DateTime               @default(now()) @updatedAt @db.Timestamptz(3)

  organization  Organization            @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  internship    Internship              @relation(fields: [internship_id], references: [id], onDelete: Cascade)
  assignee      User?                   @relation("OnboardingAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  completer     User?                   @relation("OnboardingCompleter", fields: [completed_by], references: [id], onDelete: SetNull)
  onboarding    Onboarding?             @relation(fields: [onboarding_id], references: [id], onDelete: Cascade)
  template_item OnboardingTemplateItem? @relation(fields: [template_item_id], references: [id], onDelete: SetNull)
  document      InternshipDocument?     @relation(fields: [document_id], references: [id], onDelete: SetNull)
  policy        Policy?                 @relation(fields: [policy_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([internship_id, sort_order])
  @@index([assigned_to, status])
  @@index([onboarding_id])
  @@map("onboarding_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROJECTS & TASKS
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String        @db.Uuid
  name                String
  slug                String
  description         String?
  status              ProjectStatus @default(PLANNING)
  priority            TaskPriority  @default(MEDIUM)
  start_date          DateTime?     @db.Date
  target_end_date     DateTime?     @db.Date
  completed_at        DateTime?     @db.Timestamptz(3)
  owner_id            String?       @db.Uuid
  manager_id          String?       @db.Uuid
  created_by          String?       @db.Uuid
  /// Cached: completed ÷ non-cancelled top-level tasks, maintained by projectProgressService.
  progress_percentage Int           @default(0)
  created_at          DateTime      @default(now()) @db.Timestamptz(3)
  updated_at          DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at          DateTime?     @db.Timestamptz(3)

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  owner        User?               @relation("ProjectOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  manager      User?               @relation("ProjectManager", fields: [manager_id], references: [id], onDelete: SetNull)
  creator      User?               @relation("ProjectCreator", fields: [created_by], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  milestones   Milestone[]
  tasks        Task[]
  attachments  ProjectAttachment[]

  @@unique([organization_id, slug])
  @@index([organization_id, status])
  @@index([owner_id])
  @@index([manager_id])
  @@map("projects")
}

model ProjectMember {
  project_id String            @db.Uuid
  user_id    String            @db.Uuid
  role       ProjectMemberRole @default(CONTRIBUTOR)
  added_by   String?           @db.Uuid
  created_at DateTime          @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  adder   User?   @relation("ProjectMemberAdder", fields: [added_by], references: [id], onDelete: SetNull)

  @@id([project_id, user_id])
  @@index([user_id])
  @@map("project_members")
}

model Milestone {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id   String          @db.Uuid
  name         String
  description  String?
  start_date   DateTime?       @db.Date
  due_date     DateTime?       @db.Date
  status       MilestoneStatus @default(UPCOMING)
  position     Int             @default(0)
  completed_at DateTime?       @db.Timestamptz(3)
  created_at   DateTime        @default(now()) @db.Timestamptz(3)
  updated_at   DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([project_id])
  @@index([due_date])
  @@index([project_id, position])
  @@map("milestones")
}

model Task {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String       @db.Uuid
  project_id        String?      @db.Uuid
  milestone_id      String?      @db.Uuid
  parent_task_id    String?      @db.Uuid
  title             String
  description       String?
  status            TaskStatus   @default(BACKLOG)
  priority          TaskPriority @default(MEDIUM)
  created_by        String       @db.Uuid
  updated_by        String?      @db.Uuid
  start_date        DateTime?    @db.Date
  /// Calendar date; deadline states are computed in the organization's timezone.
  due_date          DateTime?    @db.Date
  estimated_minutes Int?
  actual_minutes    Int?
  position          Int          @default(0)
  /// Status before the last transition (e.g. what BLOCKED resumes to).
  previous_status   TaskStatus?
  blocked_reason    String?
  started_at        DateTime?    @db.Timestamptz(3)
  completed_at      DateTime?    @db.Timestamptz(3)
  /// Foundation only: recurrence is not generated yet.
  is_recurring      Boolean      @default(false)
  recurrence_rule   String?
  created_at        DateTime     @default(now()) @db.Timestamptz(3)
  updated_at        DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at        DateTime?    @db.Timestamptz(3)

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  project      Project?            @relation(fields: [project_id], references: [id], onDelete: Restrict)
  milestone    Milestone?          @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  parent_task  Task?               @relation("TaskSubtasks", fields: [parent_task_id], references: [id], onDelete: SetNull)
  subtasks     Task[]              @relation("TaskSubtasks")
  creator      User                @relation("TaskCreator", fields: [created_by], references: [id], onDelete: Restrict)
  updater      User?               @relation("TaskUpdater", fields: [updated_by], references: [id], onDelete: SetNull)
  assignees    TaskAssignee[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  submissions  TaskSubmission[]
  checklist    TaskChecklistItem[]
  dependencies TaskDependency[]    @relation("TaskDependsOn")
  dependents   TaskDependency[]    @relation("TaskDependents")
  time_entries TaskTimeEntry[]

  @@index([organization_id, status])
  @@index([organization_id, priority])
  @@index([project_id, status, position])
  @@index([organization_id, due_date])
  @@index([project_id])
  @@index([milestone_id])
  @@index([parent_task_id])
  @@index([created_by])
  @@map("tasks")
}

model TaskAssignee {
  task_id     String   @db.Uuid
  user_id     String   @db.Uuid
  assigned_by String?  @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(3)

  task     Task  @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user     User  @relation("TaskAssignee", fields: [user_id], references: [id], onDelete: Cascade)
  assigner User? @relation("TaskAssigner", fields: [assigned_by], references: [id], onDelete: SetNull)

  @@id([task_id, user_id])
  @@index([user_id])
  @@map("task_assignees")
}

model TaskComment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id    String    @db.Uuid
  user_id    String    @db.Uuid
  parent_id  String?   @db.Uuid
  body       String
  edited_at  DateTime? @db.Timestamptz(3)
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at DateTime? @db.Timestamptz(3)

  task     Task                 @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [user_id], references: [id], onDelete: Restrict)
  parent   TaskComment?         @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies  TaskComment[]        @relation("CommentReplies")
  mentions TaskCommentMention[]

  @@index([task_id, created_at])
  @@index([user_id])
  @@index([parent_id])
  @@map("task_comments")
}

model TaskAttachment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id               String    @db.Uuid
  uploaded_by           String?   @db.Uuid
  file_name             String
  storage_path          String
  mime_type             String
  file_size             Int
  /// Set when the file was attached to a specific submission version.
  submission_version_id String?   @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamptz(3)
  deleted_at            DateTime? @db.Timestamptz(3)

  task               Task               @relation(fields: [task_id], references: [id], onDelete: Cascade)
  uploader           User?              @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)
  submission_version SubmissionVersion? @relation(fields: [submission_version_id], references: [id], onDelete: SetNull)

  @@index([task_id])
  @@index([submission_version_id])
  @@map("task_attachments")
}

model TaskSubmission {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id        String           @db.Uuid
  submitted_by   String           @db.Uuid
  status         SubmissionStatus @default(DRAFT)
  description    String?
  submitted_at   DateTime?        @db.Timestamptz(3)
  reviewed_at    DateTime?        @db.Timestamptz(3)
  reviewed_by    String?          @db.Uuid
  review_comment String?
  created_at     DateTime         @default(now()) @db.Timestamptz(3)
  updated_at     DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  task     Task                @relation(fields: [task_id], references: [id], onDelete: Restrict)
  author   User                @relation("SubmissionAuthor", fields: [submitted_by], references: [id], onDelete: Restrict)
  reviewer User?               @relation("SubmissionReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)
  versions SubmissionVersion[]

  @@index([task_id])
  @@index([submitted_by])
  @@index([status])
  @@map("task_submissions")
}

model SubmissionVersion {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id  String           @db.Uuid
  version_number Int
  description    String?
  status         SubmissionStatus @default(SUBMITTED)
  submitted_at   DateTime         @default(now()) @db.Timestamptz(3)
  reviewed_by    String?          @db.Uuid
  reviewed_at    DateTime?        @db.Timestamptz(3)
  review_comment String?
  created_by     String?          @db.Uuid
  created_at     DateTime         @default(now()) @db.Timestamptz(3)

  submission  TaskSubmission   @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  creator     User?            @relation(fields: [created_by], references: [id], onDelete: SetNull)
  reviewer    User?            @relation("VersionReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)
  attachments TaskAttachment[]

  @@unique([submission_id, version_number])
  @@map("submission_versions")
}

model TaskCommentMention {
  comment_id String @db.Uuid
  user_id    String @db.Uuid

  comment TaskComment @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user    User        @relation("CommentMentions", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([comment_id, user_id])
  @@index([user_id])
  @@map("task_comment_mentions")
}

model TaskChecklistItem {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id      String    @db.Uuid
  title        String
  is_completed Boolean   @default(false)
  completed_by String?   @db.Uuid
  completed_at DateTime? @db.Timestamptz(3)
  position     Int       @default(0)
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  task      Task  @relation(fields: [task_id], references: [id], onDelete: Cascade)
  completer User? @relation("ChecklistCompleter", fields: [completed_by], references: [id], onDelete: SetNull)

  @@index([task_id, position])
  @@map("task_checklist_items")
}

/// task_id cannot start until depends_on_task_id is completed (BLOCKS).
model TaskDependency {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id            String             @db.Uuid
  depends_on_task_id String             @db.Uuid
  dependency_type    TaskDependencyType @default(BLOCKS)
  created_by         String?            @db.Uuid
  created_at         DateTime           @default(now()) @db.Timestamptz(3)

  task       Task  @relation("TaskDependsOn", fields: [task_id], references: [id], onDelete: Cascade)
  depends_on Task  @relation("TaskDependents", fields: [depends_on_task_id], references: [id], onDelete: Cascade)
  creator    User? @relation("DependencyCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@unique([task_id, depends_on_task_id])
  @@index([depends_on_task_id])
  @@map("task_dependencies")
}

model TaskTimeEntry {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id          String    @db.Uuid
  user_id          String    @db.Uuid
  started_at       DateTime? @db.Timestamptz(3)
  ended_at         DateTime? @db.Timestamptz(3)
  duration_minutes Int
  description      String?
  created_at       DateTime  @default(now()) @db.Timestamptz(3)

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user User @relation("TimeEntries", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@index([user_id, created_at])
  @@map("task_time_entries")
}

model ProjectAttachment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  project_id      String    @db.Uuid
  uploaded_by     String?   @db.Uuid
  file_name       String
  storage_path    String
  mime_type       String
  file_size       Int
  description     String?
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  deleted_at      DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  project      Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  uploader     User?        @relation("ProjectFileUploader", fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([project_id])
  @@map("project_attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE & LEAVE
// ─────────────────────────────────────────────────────────────────────────────

model Attendance {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String           @db.Uuid
  user_id         String           @db.Uuid
  date            DateTime         @db.Date
  check_in_at     DateTime?        @db.Timestamptz(3)
  check_out_at    DateTime?        @db.Timestamptz(3)
  total_minutes   Int?
  status          AttendanceStatus @default(PRESENT)
  notes           String?
  break_minutes   Int              @default(0)
  is_late         Boolean          @default(false)
  late_minutes    Int?
  /// SELF (check-in/out), CORRECTION (approved correction) or HR (manual entry).
  source          String           @default("SELF")
  updated_by      String?          @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamptz(3)
  updated_at      DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization           @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User                   @relation(fields: [user_id], references: [id], onDelete: Restrict)
  updater      User?                  @relation("AttendanceUpdater", fields: [updated_by], references: [id], onDelete: SetNull)
  corrections  AttendanceCorrection[]
  breaks       AttendanceBreak[]

  @@unique([user_id, date])
  @@index([organization_id, date])
  @@index([status])
  @@map("attendance")
}

model AttendanceBreak {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendance_id String    @db.Uuid
  started_at    DateTime  @db.Timestamptz(3)
  ended_at      DateTime? @db.Timestamptz(3)
  created_at    DateTime  @default(now()) @db.Timestamptz(3)

  attendance Attendance @relation(fields: [attendance_id], references: [id], onDelete: Cascade)

  @@index([attendance_id])
  @@map("attendance_breaks")
}

model AttendanceCorrection {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String             @db.Uuid
  /// Whose attendance is corrected (requested_by may be HR acting for them).
  user_id             String             @db.Uuid
  date                DateTime           @db.Date
  attendance_id       String?            @db.Uuid
  category            CorrectionCategory @default(OTHER)
  /// Values before the correction — kept for the audit trail.
  original_check_in   DateTime?          @db.Timestamptz(3)
  original_check_out  DateTime?          @db.Timestamptz(3)
  requested_by        String             @db.Uuid
  reason              String
  requested_check_in  DateTime?          @db.Timestamptz(3)
  requested_check_out DateTime?          @db.Timestamptz(3)
  status              CorrectionStatus   @default(PENDING)
  reviewed_by         String?            @db.Uuid
  reviewed_at         DateTime?          @db.Timestamptz(3)
  review_comment      String?
  created_at          DateTime           @default(now()) @db.Timestamptz(3)
  updated_at          DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation("CorrectionSubject", fields: [user_id], references: [id], onDelete: Restrict)
  attendance   Attendance?  @relation(fields: [attendance_id], references: [id], onDelete: Restrict)
  requester    User         @relation("CorrectionRequester", fields: [requested_by], references: [id], onDelete: Restrict)
  reviewer     User?        @relation("CorrectionReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([attendance_id])
  @@index([organization_id, status])
  @@index([user_id, date])
  @@index([requested_by])
  @@index([status])
  @@map("attendance_corrections")
}

model LeaveType {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String   @db.Uuid
  name                String
  slug                String
  description         String?
  requires_approval   Boolean  @default(true)
  is_active           Boolean  @default(true)
  /// Days allowed per internship; null = unlimited (tracked, not capped).
  quota_days          Int?
  requires_attachment Boolean  @default(false)
  sort_order          Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  leave_requests LeaveRequest[]
  balances       LeaveBalance[]

  @@unique([organization_id, slug])
  @@map("leave_types")
}

model LeaveRequest {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String      @db.Uuid
  user_id          String      @db.Uuid
  leave_type_id    String      @db.Uuid
  start_date       DateTime    @db.Date
  end_date         DateTime    @db.Date
  reason           String?
  attachment_path  String?
  status           LeaveStatus @default(PENDING)
  reviewed_by      String?     @db.Uuid
  reviewed_at      DateTime?   @db.Timestamptz(3)
  review_comment   String?
  /// Working days covered (weekends and holidays excluded), fixed at request time.
  days             Int         @default(0)
  created_by       String?     @db.Uuid
  cancelled_at     DateTime?   @db.Timestamptz(3)
  cancelled_by     String?     @db.Uuid
  overlap_override Boolean     @default(false)
  override_reason  String?
  created_at       DateTime    @default(now()) @db.Timestamptz(3)
  updated_at       DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation("LeaveRequester", fields: [user_id], references: [id], onDelete: Restrict)
  leave_type   LeaveType    @relation(fields: [leave_type_id], references: [id], onDelete: Restrict)
  reviewer     User?        @relation("LeaveReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)
  creator      User?        @relation("LeaveCreator", fields: [created_by], references: [id], onDelete: SetNull)
  canceller    User?        @relation("LeaveCanceller", fields: [cancelled_by], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@index([user_id, start_date])
  @@index([leave_type_id])
  @@index([organization_id, start_date, end_date])
  @@map("leave_requests")
}

model LeaveBalance {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  leave_type_id   String   @db.Uuid
  allocated_days  Int
  notes           String?
  updated_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation("LeaveBalanceOwner", fields: [user_id], references: [id], onDelete: Cascade)
  leave_type   LeaveType    @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)
  updater      User?        @relation("LeaveBalanceUpdater", fields: [updated_by], references: [id], onDelete: SetNull)

  @@unique([user_id, leave_type_id])
  @@index([organization_id])
  @@map("leave_balances")
}

model Holiday {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  date            DateTime @db.Date
  name            String
  description     String?
  is_optional     Boolean  @default(false)
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  creator      User?        @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@unique([organization_id, date])
  @@map("holidays")
}

// ─────────────────────────────────────────────────────────────────────────────
// HR REQUESTS & OFFBOARDING
// ─────────────────────────────────────────────────────────────────────────────

model HrRequest {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String            @db.Uuid
  requester_id    String            @db.Uuid
  category        HrRequestCategory
  subject         String
  description     String
  status          HrRequestStatus   @default(OPEN)
  assigned_to     String?           @db.Uuid
  resolution      String?
  resolved_at     DateTime?         @db.Timestamptz(3)
  resolved_by     String?           @db.Uuid
  created_at      DateTime          @default(now()) @db.Timestamptz(3)
  updated_at      DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at      DateTime?         @db.Timestamptz(3)

  organization Organization          @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  requester    User                  @relation("HrRequester", fields: [requester_id], references: [id], onDelete: Restrict)
  assignee     User?                 @relation("HrRequestAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  resolver     User?                 @relation("HrRequestResolver", fields: [resolved_by], references: [id], onDelete: SetNull)
  comments     HrRequestComment[]
  attachments  HrRequestAttachment[]

  @@index([organization_id, status])
  @@index([requester_id])
  @@index([assigned_to])
  @@map("hr_requests")
}

model HrRequestComment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id String   @db.Uuid
  author_id  String   @db.Uuid
  body       String
  created_at DateTime @default(now()) @db.Timestamptz(3)

  request HrRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [author_id], references: [id], onDelete: Restrict)

  @@index([request_id, created_at])
  @@map("hr_request_comments")
}

model HrRequestAttachment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id   String    @db.Uuid
  uploaded_by  String?   @db.Uuid
  file_name    String
  storage_path String
  mime_type    String
  file_size    Int
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  deleted_at   DateTime? @db.Timestamptz(3)

  request  HrRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  uploader User?     @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([request_id])
  @@map("hr_request_attachments")
}

/// Offboarding preparation (foundation — certificates/exit feedback arrive later).
model OffboardingChecklist {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  intern_id       String    @unique @db.Uuid
  internship_id   String?   @db.Uuid
  started_by      String?   @db.Uuid
  started_at      DateTime  @default(now()) @db.Timestamptz(3)
  completed_at    DateTime? @db.Timestamptz(3)
  notes           String?

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern       Intern            @relation(fields: [intern_id], references: [id], onDelete: Cascade)
  internship   Internship?       @relation(fields: [internship_id], references: [id], onDelete: SetNull)
  starter      User?             @relation(fields: [started_by], references: [id], onDelete: SetNull)
  items        OffboardingItem[]

  @@index([organization_id])
  @@map("offboarding_checklists")
}

model OffboardingItem {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checklist_id String                 @db.Uuid
  title        String
  description  String?
  owner_role   OnboardingAssigneeRole @default(HR)
  assigned_to  String?                @db.Uuid
  due_date     DateTime?              @db.Date
  status       OffboardingItemStatus  @default(PENDING)
  completed_by String?                @db.Uuid
  completed_at DateTime?              @db.Timestamptz(3)
  note         String?
  sort_order   Int                    @default(0)
  created_at   DateTime               @default(now()) @db.Timestamptz(3)
  updated_at   DateTime               @default(now()) @updatedAt @db.Timestamptz(3)

  checklist OffboardingChecklist @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  assignee  User?                @relation("OffboardingAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  completer User?                @relation("OffboardingCompleter", fields: [completed_by], references: [id], onDelete: SetNull)

  @@index([checklist_id, sort_order])
  @@map("offboarding_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEARNING
// ─────────────────────────────────────────────────────────────────────────────

model Course {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String           @db.Uuid
  title               String
  slug                String
  description         String?
  thumbnail_url       String?
  status              CourseStatus     @default(DRAFT)
  category_id         String?          @db.Uuid
  difficulty          CourseDifficulty @default(BEGINNER)
  estimated_minutes   Int?
  /// REQUIRED vs OPTIONAL training (who must take it is set by required_training_rules).
  is_required         Boolean          @default(false)
  /// Lessons unlock in order (a lesson can't be completed before the previous required one).
  is_sequential       Boolean          @default(false)
  /// Completion rule: required lessons AND (if set) required quizzes passed AND required assignments approved.
  require_quizzes     Boolean          @default(true)
  require_assignments Boolean          @default(true)
  published_at        DateTime?        @db.Timestamptz(3)
  created_by          String?          @db.Uuid
  updated_by          String?          @db.Uuid
  created_at          DateTime         @default(now()) @db.Timestamptz(3)
  updated_at          DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at          DateTime?        @db.Timestamptz(3)

  organization      Organization           @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  creator           User?                  @relation("CourseCreator", fields: [created_by], references: [id], onDelete: SetNull)
  updater           User?                  @relation("CourseUpdater", fields: [updated_by], references: [id], onDelete: SetNull)
  category          CourseCategory?        @relation(fields: [category_id], references: [id], onDelete: SetNull)
  modules           CourseModule[]
  lessons           Lesson[]
  quizzes           Quiz[]
  assignments       LearningAssignment[]
  enrollments       CourseEnrollment[]
  learning_progress LearningProgress[]
  path_courses      LearningPathCourse[]
  plan_items        LearningPlanItem[]     @relation("PlanItemCourse")
  prerequisite_for  LearningPlanItem[]     @relation("PlanItemPrerequisite")
  required_rules    RequiredTrainingRule[]
  development_items DevelopmentPlanItem[]

  @@unique([organization_id, slug])
  @@index([organization_id, status])
  @@index([category_id])
  @@map("courses")
}

model CourseCategory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  slug            String
  description     String?
  sort_order      Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  courses      Course[]

  @@unique([organization_id, slug])
  @@map("course_categories")
}

model CourseModule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id   String   @db.Uuid
  title       String
  description String?
  position    Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  course      Course               @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  quizzes     Quiz[]
  assignments LearningAssignment[]

  @@index([course_id, position])
  @@map("course_modules")
}

model Lesson {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id         String            @db.Uuid
  module_id         String            @db.Uuid
  title             String
  description       String?
  content_type      LessonContentType @default(TEXT)
  /// Plain text (rendered as paragraphs / simple lists — never as HTML).
  content           String?
  video_url         String?
  document_url      String?
  link_url          String?
  /// Position within the module.
  sort_order        Int               @default(0)
  estimated_minutes Int?
  is_required       Boolean           @default(true)
  created_at        DateTime          @default(now()) @db.Timestamptz(3)
  updated_at        DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  course            Course             @relation(fields: [course_id], references: [id], onDelete: Cascade)
  module            CourseModule       @relation(fields: [module_id], references: [id], onDelete: Cascade)
  quizzes           Quiz[]
  learning_progress LearningProgress[]

  @@index([course_id, sort_order])
  @@index([module_id, sort_order])
  @@map("lessons")
}

model Quiz {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id          String           @db.Uuid
  module_id          String?          @db.Uuid
  lesson_id          String?          @db.Uuid
  title              String
  description        String?
  /// Passing percentage (0–100).
  passing_score      Int              @default(70)
  attempt_limit      Int?
  time_limit_minutes Int?
  answer_policy      QuizAnswerPolicy @default(AFTER_SUBMISSION)
  status             CourseStatus     @default(DRAFT)
  is_required        Boolean          @default(true)
  position           Int              @default(0)
  created_at         DateTime         @default(now()) @db.Timestamptz(3)
  updated_at         DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  course    Course         @relation(fields: [course_id], references: [id], onDelete: Cascade)
  module    CourseModule?  @relation(fields: [module_id], references: [id], onDelete: SetNull)
  lesson    Lesson?        @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([lesson_id])
  @@index([course_id])
  @@map("quizzes")
}

model QuizQuestion {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quiz_id          String           @db.Uuid
  question         String
  question_type    QuizQuestionType
  points           Int              @default(1)
  position         Int              @default(0)
  explanation      String?
  /// SHORT_ANSWER accepted answers — server-only.
  accepted_answers String[]         @default([])
  created_at       DateTime         @default(now()) @db.Timestamptz(3)

  quiz    Quiz         @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@index([quiz_id, position])
  @@map("quiz_questions")
}

model QuizOption {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id String  @db.Uuid
  option_text String
  /// Server-only until the answer policy allows it.
  is_correct  Boolean @default(false)
  position    Int     @default(0)

  question QuizQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([question_id])
  @@map("quiz_options")
}

model QuizAnswer {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attempt_id          String   @db.Uuid
  question_id         String   @db.Uuid
  selected_option_ids String[] @default([]) @db.Uuid
  text_answer         String?
  is_correct          Boolean  @default(false)
  points_awarded      Int      @default(0)

  attempt  QuizAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([attempt_id, question_id])
  @@map("quiz_answers")
}

model QuizAttempt {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quiz_id        String            @db.Uuid
  user_id        String            @db.Uuid
  attempt_number Int               @default(1)
  status         QuizAttemptStatus @default(IN_PROGRESS)
  /// Points earned and available — always calculated on the server.
  score          Int?
  max_score      Int?
  percentage     Int?
  passed         Boolean?
  started_at     DateTime          @default(now()) @db.Timestamptz(3)
  submitted_at   DateTime?         @db.Timestamptz(3)
  attempted_at   DateTime          @default(now()) @db.Timestamptz(3)

  quiz    Quiz         @relation(fields: [quiz_id], references: [id], onDelete: Restrict)
  user    User         @relation(fields: [user_id], references: [id], onDelete: Restrict)
  answers QuizAnswer[]

  @@unique([quiz_id, user_id, attempt_number])
  @@index([quiz_id])
  @@index([user_id])
  @@map("quiz_attempts")
}

/// Course-level progress rows have lesson_id = NULL; lesson-level rows set it.
/// Lesson progress (one row per person and lesson). Course-level progress lives on course_enrollments.
model LearningProgress {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String         @db.Uuid
  course_id        String         @db.Uuid
  lesson_id        String?        @db.Uuid
  status           LearningStatus @default(NOT_STARTED)
  progress_percent Int            @default(0)
  started_at       DateTime?      @db.Timestamptz(3)
  completed_at     DateTime?      @db.Timestamptz(3)
  last_accessed_at DateTime?      @db.Timestamptz(3)
  created_at       DateTime       @default(now()) @db.Timestamptz(3)
  updated_at       DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  user   User    @relation(fields: [user_id], references: [id], onDelete: Restrict)
  course Course  @relation(fields: [course_id], references: [id], onDelete: Restrict)
  lesson Lesson? @relation(fields: [lesson_id], references: [id], onDelete: SetNull)

  @@unique([user_id, course_id, lesson_id])
  @@index([course_id])
  @@index([user_id, course_id])
  @@map("learning_progress")
}

model CourseEnrollment {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String           @db.Uuid
  course_id           String           @db.Uuid
  user_id             String           @db.Uuid
  enrollment_type     EnrollmentType
  status              EnrollmentStatus @default(NOT_STARTED)
  progress_percentage Int              @default(0)
  assigned_by         String?          @db.Uuid
  assigned_at         DateTime         @default(now()) @db.Timestamptz(3)
  due_date            DateTime?        @db.Date
  started_at          DateTime?        @db.Timestamptz(3)
  completed_at        DateTime?        @db.Timestamptz(3)
  cancelled_at        DateTime?        @db.Timestamptz(3)
  learning_plan_id    String?          @db.Uuid
  required_rule_id    String?          @db.Uuid
  created_at          DateTime         @default(now()) @db.Timestamptz(3)
  updated_at          DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  course        Course                @relation(fields: [course_id], references: [id], onDelete: Restrict)
  user          User                  @relation("EnrollmentUser", fields: [user_id], references: [id], onDelete: Cascade)
  assigner      User?                 @relation("EnrollmentAssigner", fields: [assigned_by], references: [id], onDelete: SetNull)
  learning_plan LearningPlan?         @relation(fields: [learning_plan_id], references: [id], onDelete: SetNull)
  required_rule RequiredTrainingRule? @relation(fields: [required_rule_id], references: [id], onDelete: SetNull)

  @@unique([course_id, user_id])
  @@index([organization_id, status])
  @@index([user_id, status])
  @@index([due_date])
  @@map("course_enrollments")
}

model LearningPath {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  name            String
  slug            String
  description     String?
  department_id   String?      @db.Uuid
  /// "Role" the path is for (an intern position, e.g. Web development intern).
  position_id     String?      @db.Uuid
  status          CourseStatus @default(DRAFT)
  created_by      String?      @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamptz(3)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at      DateTime?    @db.Timestamptz(3)

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  department   Department?          @relation(fields: [department_id], references: [id], onDelete: SetNull)
  position     Position?            @relation(fields: [position_id], references: [id], onDelete: SetNull)
  creator      User?                @relation(fields: [created_by], references: [id], onDelete: SetNull)
  courses      LearningPathCourse[]
  plans        LearningPlan[]

  @@unique([organization_id, slug])
  @@map("learning_paths")
}

model LearningPathCourse {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learning_path_id  String  @db.Uuid
  course_id         String  @db.Uuid
  position          Int     @default(0)
  is_required       Boolean @default(true)
  /// Prerequisite: the previous course in the path must be completed first.
  requires_previous Boolean @default(false)
  /// Days after assignment this course is due.
  due_days          Int?

  learning_path LearningPath @relation(fields: [learning_path_id], references: [id], onDelete: Cascade)
  course        Course       @relation(fields: [course_id], references: [id], onDelete: Restrict)

  @@unique([learning_path_id, course_id])
  @@map("learning_path_courses")
}

/// A person's copy of a learning path at assignment time (path edits don't change plans).
model LearningPlan {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String             @db.Uuid
  user_id          String             @db.Uuid
  learning_path_id String?            @db.Uuid
  path_name        String
  status           LearningPlanStatus @default(ACTIVE)
  assigned_by      String?            @db.Uuid
  assigned_at      DateTime           @default(now()) @db.Timestamptz(3)
  due_date         DateTime?          @db.Date
  completed_at     DateTime?          @db.Timestamptz(3)

  organization  Organization       @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user          User               @relation("PlanUser", fields: [user_id], references: [id], onDelete: Cascade)
  learning_path LearningPath?      @relation(fields: [learning_path_id], references: [id], onDelete: SetNull)
  assigner      User?              @relation("PlanAssigner", fields: [assigned_by], references: [id], onDelete: SetNull)
  items         LearningPlanItem[]
  enrollments   CourseEnrollment[]

  @@index([user_id])
  @@index([organization_id, status])
  @@map("learning_plans")
}

model LearningPlanItem {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learning_plan_id       String    @db.Uuid
  course_id              String    @db.Uuid
  position               Int       @default(0)
  is_required            Boolean   @default(true)
  prerequisite_course_id String?   @db.Uuid
  due_date               DateTime? @db.Date

  plan         LearningPlan @relation(fields: [learning_plan_id], references: [id], onDelete: Cascade)
  course       Course       @relation("PlanItemCourse", fields: [course_id], references: [id], onDelete: Restrict)
  prerequisite Course?      @relation("PlanItemPrerequisite", fields: [prerequisite_course_id], references: [id], onDelete: SetNull)

  @@unique([learning_plan_id, course_id])
  @@map("learning_plan_items")
}

model RequiredTrainingRule {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String                 @db.Uuid
  course_id       String                 @db.Uuid
  target_type     RequiredTrainingTarget
  /// Department, position, intern or onboarding template id (null for EVERYONE).
  target_id       String?                @db.Uuid
  due_days        Int                    @default(14)
  is_active       Boolean                @default(true)
  created_by      String?                @db.Uuid
  created_at      DateTime               @default(now()) @db.Timestamptz(3)

  organization Organization       @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  course       Course             @relation(fields: [course_id], references: [id], onDelete: Cascade)
  creator      User?              @relation(fields: [created_by], references: [id], onDelete: SetNull)
  enrollments  CourseEnrollment[]

  @@index([organization_id, is_active])
  @@map("required_training_rules")
}

model LearningAssignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id    String   @db.Uuid
  module_id    String?  @db.Uuid
  title        String
  description  String?
  instructions String?
  /// Days after enrollment the assignment is due.
  due_days     Int?
  /// Optional points; when set, a rubric is required (enforced by a CHECK).
  max_points   Int?
  rubric       String?
  is_required  Boolean  @default(true)
  position     Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  course      Course                         @relation(fields: [course_id], references: [id], onDelete: Cascade)
  module      CourseModule?                  @relation(fields: [module_id], references: [id], onDelete: SetNull)
  submissions LearningAssignmentSubmission[]

  @@index([course_id])
  @@map("learning_assignments")
}

/// One per person and assignment; each submit/resubmit adds an immutable version (same rules as task submissions).
model LearningAssignmentSubmission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String           @db.Uuid
  assignment_id   String           @db.Uuid
  user_id         String           @db.Uuid
  status          SubmissionStatus @default(DRAFT)
  draft_text      String?
  current_version Int              @default(0)
  points_awarded  Int?
  reviewed_by     String?          @db.Uuid
  reviewed_at     DateTime?        @db.Timestamptz(3)
  review_comment  String?
  created_at      DateTime         @default(now()) @db.Timestamptz(3)
  updated_at      DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization                @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  assignment   LearningAssignment          @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  user         User                        @relation("AssignmentSubmitter", fields: [user_id], references: [id], onDelete: Cascade)
  reviewer     User?                       @relation("AssignmentReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)
  versions     LearningSubmissionVersion[]

  @@unique([assignment_id, user_id])
  @@index([organization_id, status])
  @@map("learning_assignment_submissions")
}

model LearningSubmissionVersion {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id  String           @db.Uuid
  version_number Int
  message        String?
  status         SubmissionStatus @default(SUBMITTED)
  submitted_by   String?          @db.Uuid
  submitted_at   DateTime         @default(now()) @db.Timestamptz(3)
  reviewed_by    String?          @db.Uuid
  reviewed_at    DateTime?        @db.Timestamptz(3)
  review_comment String?
  points_awarded Int?

  submission LearningAssignmentSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  submitter  User?                        @relation("LearningVersionSubmitter", fields: [submitted_by], references: [id], onDelete: SetNull)
  reviewer   User?                        @relation("LearningVersionReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)
  files      LearningSubmissionFile[]

  @@unique([submission_id, version_number])
  @@map("learning_submission_versions")
}

model LearningSubmissionFile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version_id   String   @db.Uuid
  file_name    String
  storage_path String
  mime_type    String
  file_size    Int
  created_at   DateTime @default(now()) @db.Timestamptz(3)

  version LearningSubmissionVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)

  @@index([version_id])
  @@map("learning_submission_files")
}

