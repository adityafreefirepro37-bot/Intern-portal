// ─────────────────────────────────────────────────────────────────────────────
// PERFORMANCE
// ─────────────────────────────────────────────────────────────────────────────

model Feedback {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String              @db.Uuid
  from_user_id    String              @db.Uuid
  to_user_id      String              @db.Uuid
  intern_id       String?             @db.Uuid
  /// Topic (Phase 01); feedback_type is the Phase 06 classification.
  category        FeedbackCategory    @default(GENERAL)
  feedback_type   FeedbackType        @default(GENERAL)
  context_type    FeedbackContextType @default(GENERAL)
  context_id      String?             @db.Uuid
  body            String
  visibility      FeedbackVisibility  @default(SHARED_WITH_INTERN)
  edited_at       DateTime?           @db.Timestamptz(3)
  created_at      DateTime            @default(now()) @db.Timestamptz(3)
  updated_at      DateTime            @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  from_user    User              @relation("FeedbackFrom", fields: [from_user_id], references: [id], onDelete: Restrict)
  to_user      User              @relation("FeedbackTo", fields: [to_user_id], references: [id], onDelete: Restrict)
  intern       Intern?           @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  requests     FeedbackRequest[]

  @@index([organization_id])
  @@index([to_user_id])
  @@index([intern_id])
  @@index([context_type, context_id])
  @@map("feedback")
}

model FeedbackRequest {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String                @db.Uuid
  requester_id    String                @db.Uuid
  recipient_id    String                @db.Uuid
  intern_id       String?               @db.Uuid
  context_type    FeedbackContextType   @default(GENERAL)
  context_id      String?               @db.Uuid
  question        String
  due_date        DateTime?             @db.Date
  status          FeedbackRequestStatus @default(OPEN)
  feedback_id     String?               @db.Uuid
  created_at      DateTime              @default(now()) @db.Timestamptz(3)
  updated_at      DateTime              @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  requester    User         @relation("FeedbackRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  recipient    User         @relation("FeedbackRequestRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)
  intern       Intern?      @relation(fields: [intern_id], references: [id], onDelete: Cascade)
  feedback     Feedback?    @relation(fields: [feedback_id], references: [id], onDelete: SetNull)

  @@index([recipient_id, status])
  @@index([requester_id])
  @@map("feedback_requests")
}

model WeeklyCheckin {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String        @db.Uuid
  intern_id            String        @db.Uuid
  week_start           DateTime      @db.Date
  status               CheckinStatus @default(DRAFT)
  accomplishments      String?
  current_work         String?
  blockers             String?
  learning             String?
  support_needed       String?
  next_week_priorities String?
  submitted_at         DateTime?     @db.Timestamptz(3)
  reviewed_by          String?       @db.Uuid
  reviewed_at          DateTime?     @db.Timestamptz(3)
  review_comment       String?
  created_at           DateTime      @default(now()) @db.Timestamptz(3)
  updated_at           DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern       Intern       @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  reviewer     User?        @relation(fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@unique([intern_id, week_start])
  @@index([organization_id, status])
  @@map("weekly_checkins")
}

/// Dimension scores are 1–5 (CHECK constraint). No overall judgment is
/// computed or stored by the system.
model PerformanceReview {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String                  @db.Uuid
  intern_id             String                  @db.Uuid
  /// Primary manager (the MANAGER respondent).
  reviewer_id           String                  @db.Uuid
  mentor_id             String?                 @db.Uuid
  cycle_id              String?                 @db.Uuid
  template_id           String?                 @db.Uuid
  review_period_start   DateTime                @db.Date
  review_period_end     DateTime                @db.Date
  due_date              DateTime?               @db.Date
  /// Phase 01 fixed dimensions — unused by template-based reviews (kept, never deleted).
  technical_skills      Int?
  communication         Int?
  ownership             Int?
  quality               Int?
  reliability           Int?
  teamwork              Int?
  learning              Int?
  problem_solving       Int?
  overall_comments      String?
  status                PerformanceReviewStatus @default(DRAFT)
  self_review_enabled   Boolean                 @default(true)
  mentor_review_enabled Boolean                 @default(true)
  hr_review_enabled     Boolean                 @default(true)
  /// Respondent stages already submitted.
  stage_submitted       ReviewRespondent[]      @default([])
  submitted_at          DateTime?               @db.Timestamptz(3)
  completed_at          DateTime?               @db.Timestamptz(3)
  completed_by          String?                 @db.Uuid
  locked_at             DateTime?               @db.Timestamptz(3)
  reopened_at           DateTime?               @db.Timestamptz(3)
  reopen_reason         String?
  created_at            DateTime                @default(now()) @db.Timestamptz(3)
  updated_at            DateTime                @default(now()) @updatedAt @db.Timestamptz(3)

  organization      Organization                @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern            Intern                      @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  reviewer          User                        @relation("ReviewReviewer", fields: [reviewer_id], references: [id], onDelete: Restrict)
  mentor            User?                       @relation("ReviewMentor", fields: [mentor_id], references: [id], onDelete: SetNull)
  completer         User?                       @relation("ReviewCompleter", fields: [completed_by], references: [id], onDelete: SetNull)
  cycle             PerformanceCycle?           @relation(fields: [cycle_id], references: [id], onDelete: Restrict)
  template          PerformanceTemplate?        @relation(fields: [template_id], references: [id], onDelete: Restrict)
  answers           PerformanceReviewAnswer[]
  revisions         PerformanceReviewRevision[]
  development_plans DevelopmentPlan[]

  @@index([organization_id, status])
  @@index([intern_id])
  @@index([reviewer_id])
  @@index([cycle_id])
  @@map("performance_reviews")
}

model PerformanceTemplate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  description     String?
  is_active       Boolean  @default(true)
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  creator      User?                @relation(fields: [created_by], references: [id], onDelete: SetNull)
  sections     PerformanceSection[]
  cycles       PerformanceCycle[]
  reviews      PerformanceReview[]

  @@index([organization_id])
  @@map("performance_templates")
}

model PerformanceSection {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id String             @db.Uuid
  title       String
  description String?
  position    Int                @default(0)
  respondents ReviewRespondent[] @default([MANAGER])

  template  PerformanceTemplate   @relation(fields: [template_id], references: [id], onDelete: Cascade)
  questions PerformanceQuestion[]

  @@index([template_id, position])
  @@map("performance_sections")
}

model PerformanceQuestion {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  section_id        String             @db.Uuid
  prompt            String
  question_type     ReviewQuestionType @default(TEXT)
  /// What good looks like / rubric criteria shown next to the question.
  guidance          String?
  options           String[]           @default([])
  is_required       Boolean            @default(true)
  requires_evidence Boolean            @default(false)
  position          Int                @default(0)

  section PerformanceSection        @relation(fields: [section_id], references: [id], onDelete: Cascade)
  answers PerformanceReviewAnswer[]

  @@index([section_id, position])
  @@map("performance_questions")
}

model PerformanceCycle {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String            @db.Uuid
  name                  String
  cycle_type            ReviewCycleType
  status                ReviewCycleStatus @default(DRAFT)
  template_id           String            @db.Uuid
  start_date            DateTime          @db.Date
  due_date              DateTime          @db.Date
  department_id         String?           @db.Uuid
  self_review_enabled   Boolean           @default(true)
  mentor_review_enabled Boolean           @default(true)
  hr_review_enabled     Boolean           @default(true)
  created_by            String?           @db.Uuid
  opened_at             DateTime?         @db.Timestamptz(3)
  closed_at             DateTime?         @db.Timestamptz(3)
  created_at            DateTime          @default(now()) @db.Timestamptz(3)
  updated_at            DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  template     PerformanceTemplate @relation(fields: [template_id], references: [id], onDelete: Restrict)
  department   Department?         @relation(fields: [department_id], references: [id], onDelete: SetNull)
  creator      User?               @relation(fields: [created_by], references: [id], onDelete: SetNull)
  reviews      PerformanceReview[]

  @@index([organization_id, status])
  @@map("performance_cycles")
}

model PerformanceReviewAnswer {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  review_id        String           @db.Uuid
  question_id      String           @db.Uuid
  respondent       ReviewRespondent
  author_id        String?          @db.Uuid
  rating           Int?
  text_value       String?
  bool_value       Boolean?
  selected_options String[]         @default([])
  evidence         String?
  /// Links to real records: [{ type: 'task' | 'project' | 'course' | 'goal' | 'feedback' | 'checkin', id }].
  evidence_refs    Json             @default("[]")
  created_at       DateTime         @default(now()) @db.Timestamptz(3)
  updated_at       DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  review    PerformanceReview           @relation(fields: [review_id], references: [id], onDelete: Cascade)
  question  PerformanceQuestion         @relation(fields: [question_id], references: [id], onDelete: Restrict)
  author    User?                       @relation(fields: [author_id], references: [id], onDelete: SetNull)
  revisions PerformanceReviewRevision[]

  @@unique([review_id, question_id, respondent], map: "performance_review_answers_review_question_respondent_key")
  @@map("performance_review_answers")
}

model PerformanceReviewRevision {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  review_id  String   @db.Uuid
  answer_id  String?  @db.Uuid
  actor_id   String?  @db.Uuid
  reason     String
  before     Json
  after      Json
  created_at DateTime @default(now()) @db.Timestamptz(3)

  review PerformanceReview        @relation(fields: [review_id], references: [id], onDelete: Cascade)
  answer PerformanceReviewAnswer? @relation(fields: [answer_id], references: [id], onDelete: SetNull)
  actor  User?                    @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([review_id])
  @@map("performance_review_revisions")
}

model PerformanceGoal {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  intern_id       String       @db.Uuid
  title           String
  description     String?
  category        GoalCategory @default(OTHER)
  status          GoalStatus   @default(NOT_STARTED)
  /// Manually set in 25% steps (0, 25, 50, 75, 100) — never computed from opaque signals.
  progress        Int          @default(0)
  start_date      DateTime?    @db.Date
  target_date     DateTime?    @db.Date
  owner_id        String       @db.Uuid
  created_by      String?      @db.Uuid
  completed_at    DateTime?    @db.Timestamptz(3)
  created_at      DateTime     @default(now()) @db.Timestamptz(3)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  organization      Organization          @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern            Intern                @relation(fields: [intern_id], references: [id], onDelete: Cascade)
  owner             User                  @relation("GoalOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  creator           User?                 @relation("GoalCreator", fields: [created_by], references: [id], onDelete: SetNull)
  evidence          GoalEvidence[]
  development_items DevelopmentPlanItem[]

  @@index([organization_id, status])
  @@index([intern_id])
  @@map("performance_goals")
}

model GoalEvidence {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goal_id       String           @db.Uuid
  evidence_type GoalEvidenceType
  /// Id of the existing task / project / submission / course / feedback / document (no copies).
  reference_id  String?          @db.Uuid
  url           String?
  note          String?
  added_by      String?          @db.Uuid
  created_at    DateTime         @default(now()) @db.Timestamptz(3)

  goal  PerformanceGoal @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  adder User?           @relation(fields: [added_by], references: [id], onDelete: SetNull)

  @@index([goal_id])
  @@map("goal_evidence")
}

model DevelopmentPlan {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String                @db.Uuid
  intern_id       String                @db.Uuid
  review_id       String?               @db.Uuid
  title           String
  status          DevelopmentPlanStatus @default(ACTIVE)
  created_by      String?               @db.Uuid
  created_at      DateTime              @default(now()) @db.Timestamptz(3)
  updated_at      DateTime              @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization          @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern       Intern                @relation(fields: [intern_id], references: [id], onDelete: Cascade)
  review       PerformanceReview?    @relation(fields: [review_id], references: [id], onDelete: SetNull)
  creator      User?                 @relation(fields: [created_by], references: [id], onDelete: SetNull)
  items        DevelopmentPlanItem[]

  @@index([intern_id])
  @@map("development_plans")
}

model DevelopmentPlanItem {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan_id     String                @db.Uuid
  area        String
  action      String
  owner_id    String?               @db.Uuid
  target_date DateTime?             @db.Date
  status      DevelopmentItemStatus @default(NOT_STARTED)
  evidence    String?
  /// Recommended course (completing it is evidence, not proof of mastery).
  course_id   String?               @db.Uuid
  goal_id     String?               @db.Uuid
  position    Int                   @default(0)
  created_at  DateTime              @default(now()) @db.Timestamptz(3)
  updated_at  DateTime              @default(now()) @updatedAt @db.Timestamptz(3)

  plan   DevelopmentPlan  @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  owner  User?            @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  course Course?          @relation(fields: [course_id], references: [id], onDelete: SetNull)
  goal   PerformanceGoal? @relation(fields: [goal_id], references: [id], onDelete: SetNull)

  @@index([plan_id])
  @@map("development_plan_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNICATION
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String               @db.Uuid
  title           String
  body            String
  priority        AnnouncementPriority @default(NORMAL)
  published_by    String?              @db.Uuid
  published_at    DateTime?            @db.Timestamptz(3)
  expires_at      DateTime?            @db.Timestamptz(3)
  category        AnnouncementCategory @default(COMPANY)
  /// SCHEDULED announcements go live at published_at (daily/at-read publishing).
  status          AnnouncementStatus   @default(PUBLISHED)
  audience        AnnouncementAudience @default(EVERYONE)
  /// Department / team / user ids for DEPARTMENT, TEAM and SPECIFIC audiences.
  audience_ids    String[]             @default([]) @db.Uuid
  archived_at     DateTime?            @db.Timestamptz(3)
  notified_at     DateTime?            @db.Timestamptz(3)
  created_by      String?              @db.Uuid
  created_at      DateTime             @default(now()) @db.Timestamptz(3)
  updated_at      DateTime             @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  publisher    User?        @relation(fields: [published_by], references: [id], onDelete: SetNull)
  creator      User?        @relation("AnnouncementCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([organization_id, published_at])
  @@index([organization_id, status])
  @@map("announcements")
}

model Notification {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String    @db.Uuid
  user_id             String    @db.Uuid
  type                String
  title               String
  body                String?
  read_at             DateTime? @db.Timestamptz(3)
  related_entity_type String?
  related_entity_id   String?   @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([user_id, read_at])
  @@index([created_at])
  @@map("notifications")
}

model Channel {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String      @db.Uuid
  name            String
  slug            String
  description     String?
  channel_type    ChannelType @default(GENERAL)
  created_by      String?     @db.Uuid
  created_at      DateTime    @default(now()) @db.Timestamptz(3)
  updated_at      DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  creator      User?        @relation(fields: [created_by], references: [id], onDelete: SetNull)
  messages     Message[]

  @@unique([organization_id, slug])
  @@map("channels")
}

model Message {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel_id String    @db.Uuid
  sender_id  String    @db.Uuid
  body       String
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at DateTime? @db.Timestamptz(3)

  channel Channel @relation(fields: [channel_id], references: [id], onDelete: Restrict)
  sender  User    @relation(fields: [sender_id], references: [id], onDelete: Restrict)

  @@index([channel_id, created_at])
  @@index([sender_id])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// CERTIFICATES
// ─────────────────────────────────────────────────────────────────────────────

model Certificate {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String            @db.Uuid
  intern_id          String            @db.Uuid
  internship_id      String?           @db.Uuid
  certificate_number String            @unique
  certificate_type   CertificateType   @default(COMPLETION)
  issued_at          DateTime?         @db.Timestamptz(3)
  file_path          String?
  status             CertificateStatus @default(DRAFT)
  created_at         DateTime          @default(now()) @db.Timestamptz(3)
  updated_at         DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  organization  Organization              @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern        Intern                    @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  internship    Internship?               @relation(fields: [internship_id], references: [id], onDelete: Restrict)
  verifications CertificateVerification[]

  @@index([organization_id, status])
  @@index([intern_id])
  @@map("certificates")
}

model CertificateVerification {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificate_id     String    @db.Uuid
  verification_code  String    @unique
  verification_count Int       @default(0)
  last_verified_at   DateTime? @db.Timestamptz(3)
  created_at         DateTime  @default(now()) @db.Timestamptz(3)

  certificate Certificate @relation(fields: [certificate_id], references: [id], onDelete: Restrict)

  @@index([certificate_id])
  @@map("certificate_verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI & KNOWLEDGE (pipeline implemented in Prompt 07)
// ─────────────────────────────────────────────────────────────────────────────

model AiConversation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  title           String?
  context_type    String?
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages     AiMessage[]

  @@index([organization_id])
  @@index([user_id, updated_at])
  @@map("ai_conversations")
}

model AiMessage {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  role            AiMessageRole
  content         String
  model           String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)

  conversation AiConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@map("ai_messages")
}

model KnowledgeDocument {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String                  @db.Uuid
  title           String
  description     String?
  file_name       String
  storage_path    String
  mime_type       String
  status          KnowledgeDocumentStatus @default(PENDING)
  uploaded_by     String?                 @db.Uuid
  created_at      DateTime                @default(now()) @db.Timestamptz(3)
  updated_at      DateTime                @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  uploader     User?        @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@map("knowledge_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// SYSTEM
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only audit trail. Rows survive user deletion (actor set to NULL).
model AuditLog {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String      @db.Uuid
  actor_user_id   String?     @db.Uuid
  action          String
  resource_type   String
  resource_id     String?
  metadata        Json?
  ip_address      String?
  user_agent      String?
  status          AuditStatus @default(SUCCESS)
  created_at      DateTime    @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at(sort: Desc)])
  @@index([actor_user_id])
  @@index([resource_type, resource_id])
  @@index([organization_id, action])
  @@map("audit_logs")
}

/// Non-secret organization settings. Secrets belong in environment variables.
model Setting {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  key             String
  value           Json
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, key])
  @@map("settings")
}

/// One onboarding instance per internship (database-enforced). Its items are
/// copied from a template at generation time and never re-linked afterwards.
model Onboarding {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  internship_id   String    @unique @db.Uuid
  template_id     String?   @db.Uuid
  template_name   String
  started_at      DateTime  @default(now()) @db.Timestamptz(3)
  completed_at    DateTime? @db.Timestamptz(3)
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  internship   Internship          @relation(fields: [internship_id], references: [id], onDelete: Cascade)
  template     OnboardingTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  creator      User?               @relation(fields: [created_by], references: [id], onDelete: SetNull)
  items        OnboardingItem[]

  @@index([organization_id, completed_at])
  @@map("onboardings")
}

model OnboardingTemplate {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  name            String
  description     String?
  department_id   String?   @db.Uuid
  position_id     String?   @db.Uuid
  is_active       Boolean   @default(true)
  /// Used when no department/position-specific template matches.
  is_default      Boolean   @default(false)
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at      DateTime? @db.Timestamptz(3)

  organization Organization             @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  department   Department?              @relation(fields: [department_id], references: [id], onDelete: SetNull)
  position     Position?                @relation(fields: [position_id], references: [id], onDelete: SetNull)
  creator      User?                    @relation(fields: [created_by], references: [id], onDelete: SetNull)
  items        OnboardingTemplateItem[]
  onboardings  Onboarding[]

  @@unique([organization_id, name])
  @@index([organization_id, is_active])
  @@map("onboarding_templates")
}

model OnboardingTemplateItem {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id            String                 @db.Uuid
  title                  String
  description            String?
  category               OnboardingItemType     @default(TASK)
  required               Boolean                @default(true)
  due_days_after_start   Int                    @default(0)
  assigned_role          OnboardingAssigneeRole @default(INTERN)
  assigned_user_id       String?                @db.Uuid
  required_document_type DocumentType?
  policy_id              String?                @db.Uuid
  sort_order             Int                    @default(0)
  created_at             DateTime               @default(now()) @db.Timestamptz(3)
  updated_at             DateTime               @default(now()) @updatedAt @db.Timestamptz(3)

  template         OnboardingTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  assigned_user    User?              @relation(fields: [assigned_user_id], references: [id], onDelete: SetNull)
  policy           Policy?            @relation(fields: [policy_id], references: [id], onDelete: SetNull)
  onboarding_items OnboardingItem[]

  @@index([template_id, sort_order])
  @@map("onboarding_template_items")
}

/// Versioned policy/handbook text that people acknowledge.
model Policy {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  slug            String
  title           String
  version         Int      @default(1)
  body            String
  is_active       Boolean  @default(true)
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization     Organization              @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  creator          User?                     @relation(fields: [created_by], references: [id], onDelete: SetNull)
  acknowledgements DocumentAcknowledgement[]
  template_items   OnboardingTemplateItem[]
  onboarding_items OnboardingItem[]

  @@unique([organization_id, slug, version])
  @@map("policies")
}

/// Who acknowledged which version of a policy, and when.
model DocumentAcknowledgement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  policy_id       String   @db.Uuid
  policy_version  Int
  acknowledged_at DateTime @default(now()) @db.Timestamptz(3)
  ip_address      String?
  user_agent      String?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Restrict)
  policy       Policy       @relation(fields: [policy_id], references: [id], onDelete: Restrict)

  @@unique([user_id, policy_id, policy_version])
  @@index([organization_id])
  @@map("document_acknowledgements")
}

/// Internship history. idempotency_key prevents duplicate automated events.
model InternLifecycleEvent {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String             @db.Uuid
  intern_id       String             @db.Uuid
  event_type      LifecycleEventType
  description     String
  actor_user_id   String?            @db.Uuid
  metadata        Json?
  idempotency_key String?            @unique
  created_at      DateTime           @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern       Intern       @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([intern_id, created_at])
  @@index([organization_id, event_type])
  @@map("intern_lifecycle_events")
}

/// Per-organization counters for human-readable codes (e.g. AYV-INT-0001).
/// Incremented atomically, so concurrent creations never collide.
model CodeCounter {
  organization_id String   @db.Uuid
  key             String
  value           Int
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@id([organization_id, key])
  @@map("code_counters")
}
