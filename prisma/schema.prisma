// AYAVA INTERN OS — database schema
//
// Conventions
// - Tables are plural snake_case (@@map); columns are snake_case.
// - Primary keys are UUIDs generated by PostgreSQL (gen_random_uuid()).
// - Timestamps are timestamptz; calendar dates are `date`.
// - Organization-owned tables carry organization_id for tenant isolation.
//   Child tables (e.g. lessons, task_comments) are scoped through their parent.
// - Referential actions:
//     Restrict  — organizations and historical/business records are never
//                 removed implicitly (attendance, reviews, certificates, audit).
//     SetNull   — optional references (manager, mentor, department, actor).
//     Cascade   — pure child rows that have no meaning without their parent.
//   Users and most business records are soft-deleted via deleted_at.
// - CHECK constraints and row-level security are defined in SQL migrations
//   (see prisma/migrations) because Prisma does not model them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

