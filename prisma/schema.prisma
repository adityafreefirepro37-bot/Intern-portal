// AYAVA INTERN OS — database schema
//
// Conventions
// - Tables are plural snake_case (@@map); columns are snake_case.
// - Primary keys are UUIDs generated by PostgreSQL (gen_random_uuid()).
// - Timestamps are timestamptz; calendar dates are `date`.
// - Organization-owned tables carry organization_id for tenant isolation.
//   Child tables (e.g. lessons, task_comments) are scoped through their parent.
// - Referential actions:
//     Restrict  — organizations and historical/business records are never
//                 removed implicitly (attendance, reviews, certificates, audit).
//     SetNull   — optional references (manager, mentor, department, actor).
//     Cascade   — pure child rows that have no meaning without their parent.
//   Users and most business records are soft-deleted via deleted_at.
// - CHECK constraints and row-level security are defined in SQL migrations
//   (see prisma/migrations) because Prisma does not model them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  INACTIVE
}

enum InternStatus {
  SELECTED
  ONBOARDING
  ACTIVE
  ENDING_SOON
  COMPLETED
  ALUMNI
  TERMINATED
}

enum InternshipStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum DocumentType {
  RESUME
  OFFER_LETTER
  NDA
  ID_DOCUMENT
  CERTIFICATE
  EXPERIENCE_LETTER
  OTHER
}

enum DocumentVisibility {
  INTERN
  MANAGER
  HR
  ADMIN
}

enum OnboardingItemType {
  DOCUMENT
  ACKNOWLEDGEMENT
  MEETING
  TRAINING
  FORM
  TASK
  CHECKLIST
  ACCOUNT_SETUP
  OTHER
}

/// Who is responsible for an onboarding item.
enum OnboardingAssigneeRole {
  INTERN
  MANAGER
  MENTOR
  HR
}

enum LifecycleEventType {
  CREATED
  INVITATION_SENT
  INVITATION_ACCEPTED
  ONBOARDING_STARTED
  ONBOARDING_COMPLETED
  STATUS_CHANGED
  MANAGER_ASSIGNED
  MENTOR_ASSIGNED
  DETAILS_UPDATED
  DATES_CHANGED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
}

enum OnboardingItemStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
  SKIPPED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectMemberRole {
  OWNER
  LEAD
  MEMBER
  VIEWER
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  BACKLOG
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  CHANGES_REQUESTED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LearningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum CalendarEventType {
  MEETING
  DEADLINE
  TRAINING
  REVIEW
  LEAVE
  HOLIDAY
  OTHER
}

enum FeedbackCategory {
  GENERAL
  PRAISE
  IMPROVEMENT
  TECHNICAL
  COMMUNICATION
}

enum FeedbackVisibility {
  PRIVATE
  RECIPIENT
  MANAGERS
  HR
}

enum PerformanceReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ChannelType {
  GENERAL
  PROJECT
  TEAM
  DEPARTMENT
  DIRECT
}

enum CertificateType {
  COMPLETION
  EXCELLENCE
  PARTICIPATION
  EXPERIENCE
}

enum CertificateStatus {
  DRAFT
  ISSUED
  REVOKED
}

/// How far a granted permission reaches. Broader scopes include narrower ones.
enum PermissionScope {
  OWN
  ASSIGNED
  TEAM
  DEPARTMENT
  ORGANIZATION
}

enum AuditStatus {
  SUCCESS
  FAILURE
  DENIED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION & IDENTITY
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  logo_url    String?
  website_url String?
  description String?
  timezone    String   @default("Asia/Kolkata")
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  users                User[]
  roles                Role[]
  departments          Department[]
  teams                Team[]
  positions            Position[]
  interns              Intern[]
  internships          Internship[]
  internship_documents InternshipDocument[]
  onboarding_items     OnboardingItem[]
  projects             Project[]
  tasks                Task[]
  attendance           Attendance[]
  leave_types          LeaveType[]
  leave_requests       LeaveRequest[]
  courses              Course[]
  meetings             Meeting[]
  calendar_events      CalendarEvent[]
  feedback             Feedback[]
  performance_reviews  PerformanceReview[]
  announcements        Announcement[]
  notifications        Notification[]
  channels             Channel[]
  certificates         Certificate[]
  ai_conversations     AiConversation[]
  knowledge_documents  KnowledgeDocument[]
  audit_logs           AuditLog[]
  settings             Setting[]
  invitations          UserInvitation[]
  user_sessions        UserSession[]
  onboardings          Onboarding[]
  onboarding_templates OnboardingTemplate[]
  policies             Policy[]
  acknowledgements     DocumentAcknowledgement[]
  lifecycle_events     InternLifecycleEvent[]
  code_counters        CodeCounter[]

  @@map("organizations")
}

/// Application user profile. Credentials live in the auth provider (Supabase
/// Auth); `auth_user_id` links to it. Never store passwords here.
model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String     @db.Uuid
  auth_user_id      String?    @unique @db.Uuid
  email             String
  first_name        String
  last_name         String
  display_name      String?
  avatar_url        String?
  phone             String?
  status            UserStatus @default(INVITED)
  timezone          String?
  last_login_at     DateTime?  @db.Timestamptz(3)
  /// Set when the auth provider confirms the email address.
  email_verified_at DateTime?  @db.Timestamptz(3)
  created_at        DateTime   @default(now()) @db.Timestamptz(3)
  updated_at        DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at        DateTime?  @db.Timestamptz(3)

  organization  Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user_roles    UserRole[]   @relation("UserRoles")
  roles_granted UserRole[]   @relation("RoleGrantedBy")

  intern                  Intern?
  interns_managed         Intern[]                  @relation("InternManager")
  interns_mentored        Intern[]                  @relation("InternMentor")
  internships_managed     Internship[]              @relation("InternshipManager")
  internships_mentored    Internship[]              @relation("InternshipMentor")
  departments_led         Department[]              @relation("DepartmentHead")
  teams_led               Team[]                    @relation("TeamLead")
  documents_uploaded      InternshipDocument[]
  onboarding_assigned     OnboardingItem[]          @relation("OnboardingAssignee")
  onboarding_completed    OnboardingItem[]          @relation("OnboardingCompleter")
  projects_owned          Project[]                 @relation("ProjectOwner")
  project_memberships     ProjectMember[]
  tasks_created           Task[]                    @relation("TaskCreator")
  task_assignments        TaskAssignee[]            @relation("TaskAssignee")
  task_assignments_made   TaskAssignee[]            @relation("TaskAssigner")
  task_comments           TaskComment[]
  task_attachments        TaskAttachment[]
  submissions             TaskSubmission[]          @relation("SubmissionAuthor")
  submissions_reviewed    TaskSubmission[]          @relation("SubmissionReviewer")
  submission_versions     SubmissionVersion[]
  attendance              Attendance[]
  corrections_requested   AttendanceCorrection[]    @relation("CorrectionRequester")
  corrections_reviewed    AttendanceCorrection[]    @relation("CorrectionReviewer")
  leave_requests          LeaveRequest[]            @relation("LeaveRequester")
  leave_reviews           LeaveRequest[]            @relation("LeaveReviewer")
  courses_created         Course[]
  quiz_attempts           QuizAttempt[]
  learning_progress       LearningProgress[]
  meetings_created        Meeting[]
  calendar_events_created CalendarEvent[]
  feedback_given          Feedback[]                @relation("FeedbackFrom")
  feedback_received       Feedback[]                @relation("FeedbackTo")
  checkins_reviewed       WeeklyCheckin[]
  reviews_written         PerformanceReview[]
  announcements_published Announcement[]
  notifications           Notification[]
  channels_created        Channel[]
  messages_sent           Message[]
  ai_conversations        AiConversation[]
  knowledge_uploaded      KnowledgeDocument[]
  audit_logs              AuditLog[]
  invitations_sent        UserInvitation[]          @relation("InvitationCreator")
  invitations_revoked     UserInvitation[]          @relation("InvitationRevoker")
  invitation              UserInvitation[]          @relation("InvitationUser")
  sessions                UserSession[]
  onboardings_created     Onboarding[]
  templates_created       OnboardingTemplate[]
  template_items_assigned OnboardingTemplateItem[]
  policies_created        Policy[]
  acknowledgements        DocumentAcknowledgement[]
  lifecycle_events_acted  InternLifecycleEvent[]

  @@unique([organization_id, email])
  @@index([organization_id, status])
  @@index([email])
  // Trigram indexes for case-insensitive directory search (pg_trgm).
  @@index([first_name(ops: raw("gin_trgm_ops"))], map: "users_first_name_trgm_idx", type: Gin)
  @@index([last_name(ops: raw("gin_trgm_ops"))], map: "users_last_name_trgm_idx", type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], map: "users_email_trgm_idx", type: Gin)
  @@map("users")
}

/// Roles are data, scoped per organization. System roles are seeded and
/// flagged `is_system_role`; organizations may add their own later.
model Role {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  slug            String
  description     String?
  is_system_role  Boolean  @default(false)
  /// Privilege rank. A user may only assign roles ranked below their own
  /// (super admins excepted), which prevents privilege escalation.
  rank            Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  role_permissions RolePermission[]
  user_roles       UserRole[]
  invitations      UserInvitation[]

  @@unique([organization_id, slug])
  @@index([organization_id])
  @@map("roles")
}

/// Global permission catalog in `resource.action` form.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String
  action      String
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(3)

  role_permissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  role_id       String          @db.Uuid
  permission_id String          @db.Uuid
  /// Which records the grant covers (own, assigned, team, department, organization).
  scope         PermissionScope @default(ORGANIZATION)
  created_at    DateTime        @default(now()) @db.Timestamptz(3)

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@map("role_permissions")
}

/// Assigns roles to users (a user may hold several roles).
model UserRole {
  user_id    String   @db.Uuid
  role_id    String   @db.Uuid
  granted_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)

  user    User  @relation("UserRoles", fields: [user_id], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [role_id], references: [id], onDelete: Restrict)
  granter User? @relation("RoleGrantedBy", fields: [granted_by], references: [id], onDelete: SetNull)

  @@id([user_id, role_id])
  @@index([role_id])
  @@map("user_roles")
}

/// Invitation to join an organization. Only a SHA-256 hash of the token is
/// stored; the raw token exists only in the invitation link.
model UserInvitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  user_id         String    @db.Uuid
  email           String
  role_id         String    @db.Uuid
  token_hash      String    @unique
  expires_at      DateTime  @db.Timestamptz(3)
  accepted_at     DateTime? @db.Timestamptz(3)
  revoked_at      DateTime? @db.Timestamptz(3)
  revoked_by      String?   @db.Uuid
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation("InvitationUser", fields: [user_id], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [role_id], references: [id], onDelete: Restrict)
  creator      User?        @relation("InvitationCreator", fields: [created_by], references: [id], onDelete: SetNull)
  revoker      User?        @relation("InvitationRevoker", fields: [revoked_by], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at(sort: Desc)])
  @@index([user_id])
  @@index([email])
  // Partial unique index "user_invitations_one_pending_per_user_key" (SQL
  // migration): at most one pending invitation per user.
  @@map("user_invitations")
}

/// Sessions observed by the application, keyed by the auth provider's
/// session id (JWT `session_id` claim). Used to list devices and to revoke
/// individual sessions: a revoked session is rejected on its next request.
model UserSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  user_id         String    @db.Uuid
  auth_session_id String    @unique @db.Uuid
  user_agent      String?
  ip_address      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  last_seen_at    DateTime  @default(now()) @db.Timestamptz(3)
  revoked_at      DateTime? @db.Timestamptz(3)
  revoked_reason  String?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at])
  @@map("user_sessions")
}

/// Fixed-window rate-limit counters. Stored in PostgreSQL so limits hold
/// across multiple application instances.
model RateLimitBucket {
  key      String   @id
  count    Int
  reset_at DateTime @db.Timestamptz(3)

  @@index([reset_at])
  @@map("rate_limit_buckets")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  slug            String
  description     String?
  head_user_id    String?  @db.Uuid
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization         Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  head                 User?                @relation("DepartmentHead", fields: [head_user_id], references: [id], onDelete: SetNull)
  teams                Team[]
  positions            Position[]
  interns              Intern[]
  internships          Internship[]
  onboarding_templates OnboardingTemplate[]

  @@unique([organization_id, slug])
  @@index([organization_id])
  @@map("departments")
}

model Team {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  department_id   String?  @db.Uuid
  name            String
  slug            String
  description     String?
  team_lead_id    String?  @db.Uuid
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [department_id], references: [id], onDelete: SetNull)
  team_lead    User?        @relation("TeamLead", fields: [team_lead_id], references: [id], onDelete: SetNull)
  interns      Intern[]

  @@unique([organization_id, slug])
  @@index([organization_id])
  @@index([department_id])
  @@map("teams")
}

model Position {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  title           String
  slug            String
  description     String?
  department_id   String?  @db.Uuid
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization         Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  department           Department?          @relation(fields: [department_id], references: [id], onDelete: SetNull)
  interns              Intern[]
  internships          Internship[]
  onboarding_templates OnboardingTemplate[]

  @@unique([organization_id, slug])
  @@index([organization_id])
  @@index([department_id])
  @@map("positions")
}

// ─────────────────────────────────────────────────────────────────────────────
// INTERNS & INTERNSHIPS
// ─────────────────────────────────────────────────────────────────────────────

model Intern {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String       @db.Uuid
  user_id           String       @unique @db.Uuid
  employee_code     String
  status            InternStatus @default(SELECTED)
  joining_date      DateTime?    @db.Date
  expected_end_date DateTime?    @db.Date
  actual_end_date   DateTime?    @db.Date
  department_id     String?      @db.Uuid
  team_id           String?      @db.Uuid
  position_id       String?      @db.Uuid
  manager_id        String?      @db.Uuid
  mentor_id         String?      @db.Uuid
  created_at        DateTime     @default(now()) @db.Timestamptz(3)
  updated_at        DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at        DateTime?    @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [department_id], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [team_id], references: [id], onDelete: SetNull)
  position     Position?    @relation(fields: [position_id], references: [id], onDelete: SetNull)
  manager      User?        @relation("InternManager", fields: [manager_id], references: [id], onDelete: SetNull)
  mentor       User?        @relation("InternMentor", fields: [mentor_id], references: [id], onDelete: SetNull)

  profile             InternProfile?
  emergency_contacts  EmergencyContact[]
  internships         Internship[]
  documents           InternshipDocument[]
  feedback            Feedback[]
  weekly_checkins     WeeklyCheckin[]
  performance_reviews PerformanceReview[]
  certificates        Certificate[]
  lifecycle_events    InternLifecycleEvent[]

  @@unique([organization_id, employee_code])
  @@index([organization_id, status])
  @@index([department_id])
  @@index([team_id])
  @@index([manager_id])
  @@index([mentor_id])
  @@index([employee_code(ops: raw("gin_trgm_ops"))], map: "interns_employee_code_trgm_idx", type: Gin)
  // Partial unique index "internships_one_open_per_intern_key" lives on
  // internships (SQL migration): one PLANNED/ACTIVE internship per intern.
  @@map("interns")
}

/// Personal profile. Only data needed to run the internship is collected.
model InternProfile {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intern_id       String    @unique @db.Uuid
  date_of_birth   DateTime? @db.Date
  gender          String?
  address_line_1  String?
  address_line_2  String?
  city            String?
  state           String?
  postal_code     String?
  country         String?
  education_level String?
  institution     String?
  field_of_study  String?
  graduation_year Int?
  bio             String?
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  intern Intern @relation(fields: [intern_id], references: [id], onDelete: Cascade)

  @@map("intern_profiles")
}

model EmergencyContact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intern_id    String   @db.Uuid
  name         String
  relationship String
  phone        String
  email        String?
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  intern Intern @relation(fields: [intern_id], references: [id], onDelete: Cascade)

  @@index([intern_id])
  @@map("emergency_contacts")
}

/// A specific internship engagement (an intern may have more than one over time).
model Internship {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String           @db.Uuid
  intern_id         String           @db.Uuid
  title             String
  department_id     String?          @db.Uuid
  position_id       String?          @db.Uuid
  start_date        DateTime         @db.Date
  expected_end_date DateTime?        @db.Date
  actual_end_date   DateTime?        @db.Date
  status            InternshipStatus @default(PLANNED)
  work_mode         WorkMode         @default(REMOTE)
  location          String?
  manager_id        String?          @db.Uuid
  mentor_id         String?          @db.Uuid
  description       String?
  created_at        DateTime         @default(now()) @db.Timestamptz(3)
  updated_at        DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  organization     Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern           Intern               @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  department       Department?          @relation(fields: [department_id], references: [id], onDelete: SetNull)
  position         Position?            @relation(fields: [position_id], references: [id], onDelete: SetNull)
  manager          User?                @relation("InternshipManager", fields: [manager_id], references: [id], onDelete: SetNull)
  mentor           User?                @relation("InternshipMentor", fields: [mentor_id], references: [id], onDelete: SetNull)
  documents        InternshipDocument[]
  onboarding_items OnboardingItem[]
  onboarding       Onboarding?
  certificates     Certificate[]

  @@index([organization_id, status])
  @@index([intern_id])
  @@index([manager_id])
  @@index([mentor_id])
  @@map("internships")
}

model InternshipDocument {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String             @db.Uuid
  intern_id       String             @db.Uuid
  internship_id   String?            @db.Uuid
  document_type   DocumentType
  file_name       String
  storage_path    String
  mime_type       String
  file_size       Int
  uploaded_by     String?            @db.Uuid
  visibility      DocumentVisibility @default(HR)
  created_at      DateTime           @default(now()) @db.Timestamptz(3)
  updated_at      DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at      DateTime?          @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern           Intern           @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  internship       Internship?      @relation(fields: [internship_id], references: [id], onDelete: SetNull)
  uploader         User?            @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)
  onboarding_items OnboardingItem[]

  @@index([organization_id])
  @@index([intern_id])
  @@index([internship_id])
  @@map("internship_documents")
}

model OnboardingItem {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String                 @db.Uuid
  internship_id          String                 @db.Uuid
  title                  String
  description            String?
  item_type              OnboardingItemType     @default(TASK)
  required               Boolean                @default(true)
  status                 OnboardingItemStatus   @default(PENDING)
  due_date               DateTime?              @db.Date
  assigned_to            String?                @db.Uuid
  completed_at           DateTime?              @db.Timestamptz(3)
  completed_by           String?                @db.Uuid
  sort_order             Int                    @default(0)
  onboarding_id          String?                @db.Uuid
  /// Source template item (traceability only; the item is an independent snapshot).
  template_item_id       String?                @db.Uuid
  assigned_role          OnboardingAssigneeRole @default(INTERN)
  /// DOCUMENT items: the document type that satisfies the item, and the uploaded document.
  required_document_type DocumentType?
  document_id            String?                @db.Uuid
  /// ACKNOWLEDGEMENT items: the policy to acknowledge.
  policy_id              String?                @db.Uuid
  blocked_reason         String?
  created_at             DateTime               @default(now()) @db.Timestamptz(3)
  updated_at             DateTime               @default(now()) @updatedAt @db.Timestamptz(3)

  organization  Organization            @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  internship    Internship              @relation(fields: [internship_id], references: [id], onDelete: Cascade)
  assignee      User?                   @relation("OnboardingAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  completer     User?                   @relation("OnboardingCompleter", fields: [completed_by], references: [id], onDelete: SetNull)
  onboarding    Onboarding?             @relation(fields: [onboarding_id], references: [id], onDelete: Cascade)
  template_item OnboardingTemplateItem? @relation(fields: [template_item_id], references: [id], onDelete: SetNull)
  document      InternshipDocument?     @relation(fields: [document_id], references: [id], onDelete: SetNull)
  policy        Policy?                 @relation(fields: [policy_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([internship_id, sort_order])
  @@index([assigned_to, status])
  @@index([onboarding_id])
  @@map("onboarding_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROJECTS & TASKS
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  name            String
  slug            String
  description     String?
  status          ProjectStatus @default(PLANNED)
  start_date      DateTime?     @db.Date
  target_end_date DateTime?     @db.Date
  completed_at    DateTime?     @db.Timestamptz(3)
  owner_id        String?       @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at      DateTime?     @db.Timestamptz(3)

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  owner        User?           @relation("ProjectOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  milestones   Milestone[]
  tasks        Task[]

  @@unique([organization_id, slug])
  @@index([organization_id, status])
  @@index([owner_id])
  @@map("projects")
}

model ProjectMember {
  project_id String            @db.Uuid
  user_id    String            @db.Uuid
  role       ProjectMemberRole @default(MEMBER)
  created_at DateTime          @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([project_id, user_id])
  @@index([user_id])
  @@map("project_members")
}

model Milestone {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id  String          @db.Uuid
  name        String
  description String?
  due_date    DateTime?       @db.Date
  status      MilestoneStatus @default(PLANNED)
  created_at  DateTime        @default(now()) @db.Timestamptz(3)
  updated_at  DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([project_id])
  @@index([due_date])
  @@map("milestones")
}

model Task {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String       @db.Uuid
  project_id        String?      @db.Uuid
  milestone_id      String?      @db.Uuid
  parent_task_id    String?      @db.Uuid
  title             String
  description       String?
  status            TaskStatus   @default(BACKLOG)
  priority          TaskPriority @default(MEDIUM)
  created_by        String       @db.Uuid
  due_date          DateTime?    @db.Timestamptz(3)
  estimated_minutes Int?
  actual_minutes    Int?
  completed_at      DateTime?    @db.Timestamptz(3)
  created_at        DateTime     @default(now()) @db.Timestamptz(3)
  updated_at        DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at        DateTime?    @db.Timestamptz(3)

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  project      Project?         @relation(fields: [project_id], references: [id], onDelete: Restrict)
  milestone    Milestone?       @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  parent_task  Task?            @relation("TaskSubtasks", fields: [parent_task_id], references: [id], onDelete: SetNull)
  subtasks     Task[]           @relation("TaskSubtasks")
  creator      User             @relation("TaskCreator", fields: [created_by], references: [id], onDelete: Restrict)
  assignees    TaskAssignee[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  submissions  TaskSubmission[]

  @@index([organization_id, status])
  @@index([organization_id, due_date])
  @@index([project_id])
  @@index([milestone_id])
  @@index([parent_task_id])
  @@index([created_by])
  @@map("tasks")
}

model TaskAssignee {
  task_id     String   @db.Uuid
  user_id     String   @db.Uuid
  assigned_by String?  @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(3)

  task     Task  @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user     User  @relation("TaskAssignee", fields: [user_id], references: [id], onDelete: Cascade)
  assigner User? @relation("TaskAssigner", fields: [assigned_by], references: [id], onDelete: SetNull)

  @@id([task_id, user_id])
  @@index([user_id])
  @@map("task_assignees")
}

model TaskComment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id    String    @db.Uuid
  user_id    String    @db.Uuid
  body       String
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at DateTime? @db.Timestamptz(3)

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([task_id, created_at])
  @@index([user_id])
  @@map("task_comments")
}

model TaskAttachment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id      String    @db.Uuid
  uploaded_by  String?   @db.Uuid
  file_name    String
  storage_path String
  mime_type    String
  file_size    Int
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  deleted_at   DateTime? @db.Timestamptz(3)

  task     Task  @relation(fields: [task_id], references: [id], onDelete: Cascade)
  uploader User? @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([task_id])
  @@map("task_attachments")
}

model TaskSubmission {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id        String           @db.Uuid
  submitted_by   String           @db.Uuid
  status         SubmissionStatus @default(DRAFT)
  description    String?
  submitted_at   DateTime?        @db.Timestamptz(3)
  reviewed_at    DateTime?        @db.Timestamptz(3)
  reviewed_by    String?          @db.Uuid
  review_comment String?
  created_at     DateTime         @default(now()) @db.Timestamptz(3)
  updated_at     DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  task     Task                @relation(fields: [task_id], references: [id], onDelete: Restrict)
  author   User                @relation("SubmissionAuthor", fields: [submitted_by], references: [id], onDelete: Restrict)
  reviewer User?               @relation("SubmissionReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)
  versions SubmissionVersion[]

  @@index([task_id])
  @@index([submitted_by])
  @@index([status])
  @@map("task_submissions")
}

model SubmissionVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id  String   @db.Uuid
  version_number Int
  description    String?
  created_by     String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(3)

  submission TaskSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  creator    User?          @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@unique([submission_id, version_number])
  @@map("submission_versions")
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE & LEAVE
// ─────────────────────────────────────────────────────────────────────────────

model Attendance {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String           @db.Uuid
  user_id         String           @db.Uuid
  date            DateTime         @db.Date
  check_in_at     DateTime?        @db.Timestamptz(3)
  check_out_at    DateTime?        @db.Timestamptz(3)
  total_minutes   Int?
  status          AttendanceStatus @default(PRESENT)
  notes           String?
  created_at      DateTime         @default(now()) @db.Timestamptz(3)
  updated_at      DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization           @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User                   @relation(fields: [user_id], references: [id], onDelete: Restrict)
  corrections  AttendanceCorrection[]

  @@unique([user_id, date])
  @@index([organization_id, date])
  @@index([status])
  @@map("attendance")
}

model AttendanceCorrection {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendance_id       String           @db.Uuid
  requested_by        String           @db.Uuid
  reason              String
  requested_check_in  DateTime?        @db.Timestamptz(3)
  requested_check_out DateTime?        @db.Timestamptz(3)
  status              CorrectionStatus @default(PENDING)
  reviewed_by         String?          @db.Uuid
  reviewed_at         DateTime?        @db.Timestamptz(3)
  review_comment      String?
  created_at          DateTime         @default(now()) @db.Timestamptz(3)
  updated_at          DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  attendance Attendance @relation(fields: [attendance_id], references: [id], onDelete: Restrict)
  requester  User       @relation("CorrectionRequester", fields: [requested_by], references: [id], onDelete: Restrict)
  reviewer   User?      @relation("CorrectionReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([attendance_id])
  @@index([requested_by])
  @@index([status])
  @@map("attendance_corrections")
}

model LeaveType {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String   @db.Uuid
  name              String
  slug              String
  description       String?
  requires_approval Boolean  @default(true)
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  leave_requests LeaveRequest[]

  @@unique([organization_id, slug])
  @@map("leave_types")
}

model LeaveRequest {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String      @db.Uuid
  user_id         String      @db.Uuid
  leave_type_id   String      @db.Uuid
  start_date      DateTime    @db.Date
  end_date        DateTime    @db.Date
  reason          String?
  attachment_path String?
  status          LeaveStatus @default(PENDING)
  reviewed_by     String?     @db.Uuid
  reviewed_at     DateTime?   @db.Timestamptz(3)
  review_comment  String?
  created_at      DateTime    @default(now()) @db.Timestamptz(3)
  updated_at      DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation("LeaveRequester", fields: [user_id], references: [id], onDelete: Restrict)
  leave_type   LeaveType    @relation(fields: [leave_type_id], references: [id], onDelete: Restrict)
  reviewer     User?        @relation("LeaveReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@index([user_id, start_date])
  @@index([leave_type_id])
  @@map("leave_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEARNING
// ─────────────────────────────────────────────────────────────────────────────

model Course {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  title           String
  slug            String
  description     String?
  thumbnail_url   String?
  status          CourseStatus @default(DRAFT)
  created_by      String?      @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamptz(3)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  creator           User?              @relation(fields: [created_by], references: [id], onDelete: SetNull)
  lessons           Lesson[]
  learning_progress LearningProgress[]

  @@unique([organization_id, slug])
  @@index([organization_id, status])
  @@map("courses")
}

model Lesson {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id         String   @db.Uuid
  title             String
  description       String?
  content           String?
  video_url         String?
  sort_order        Int      @default(0)
  estimated_minutes Int?
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  course            Course             @relation(fields: [course_id], references: [id], onDelete: Cascade)
  quizzes           Quiz[]
  learning_progress LearningProgress[]

  @@index([course_id, sort_order])
  @@map("lessons")
}

model Quiz {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id     String   @db.Uuid
  title         String
  passing_score Int      @default(70)
  created_at    DateTime @default(now()) @db.Timestamptz(3)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  lesson   Lesson        @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@index([lesson_id])
  @@map("quizzes")
}

model QuizAttempt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quiz_id      String   @db.Uuid
  user_id      String   @db.Uuid
  score        Int
  passed       Boolean
  attempted_at DateTime @default(now()) @db.Timestamptz(3)

  quiz Quiz @relation(fields: [quiz_id], references: [id], onDelete: Restrict)
  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([quiz_id])
  @@index([user_id])
  @@map("quiz_attempts")
}

/// Course-level progress rows have lesson_id = NULL; lesson-level rows set it.
model LearningProgress {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String         @db.Uuid
  course_id        String         @db.Uuid
  lesson_id        String?        @db.Uuid
  status           LearningStatus @default(NOT_STARTED)
  progress_percent Int            @default(0)
  completed_at     DateTime?      @db.Timestamptz(3)
  updated_at       DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  user   User    @relation(fields: [user_id], references: [id], onDelete: Restrict)
  course Course  @relation(fields: [course_id], references: [id], onDelete: Restrict)
  lesson Lesson? @relation(fields: [lesson_id], references: [id], onDelete: SetNull)

  @@unique([user_id, course_id, lesson_id])
  @@index([course_id])
  @@map("learning_progress")
}

// ─────────────────────────────────────────────────────────────────────────────
// CALENDAR
// ─────────────────────────────────────────────────────────────────────────────

model Meeting {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  title           String
  description     String?
  start_at        DateTime @db.Timestamptz(3)
  end_at          DateTime @db.Timestamptz(3)
  location        String?
  meeting_url     String?
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  creator      User?        @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([organization_id, start_at])
  @@map("meetings")
}

model CalendarEvent {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String            @db.Uuid
  title               String
  description         String?
  event_type          CalendarEventType @default(OTHER)
  start_at            DateTime          @db.Timestamptz(3)
  end_at              DateTime?         @db.Timestamptz(3)
  created_by          String?           @db.Uuid
  related_entity_type String?
  related_entity_id   String?           @db.Uuid
  created_at          DateTime          @default(now()) @db.Timestamptz(3)
  updated_at          DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  creator      User?        @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([organization_id, start_at])
  @@index([related_entity_type, related_entity_id])
  @@map("calendar_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// PERFORMANCE
// ─────────────────────────────────────────────────────────────────────────────

model Feedback {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String             @db.Uuid
  from_user_id    String             @db.Uuid
  to_user_id      String             @db.Uuid
  intern_id       String?            @db.Uuid
  category        FeedbackCategory   @default(GENERAL)
  body            String
  visibility      FeedbackVisibility @default(RECIPIENT)
  created_at      DateTime           @default(now()) @db.Timestamptz(3)
  updated_at      DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  from_user    User         @relation("FeedbackFrom", fields: [from_user_id], references: [id], onDelete: Restrict)
  to_user      User         @relation("FeedbackTo", fields: [to_user_id], references: [id], onDelete: Restrict)
  intern       Intern?      @relation(fields: [intern_id], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([to_user_id])
  @@index([intern_id])
  @@map("feedback")
}

model WeeklyCheckin {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intern_id       String    @db.Uuid
  week_start      DateTime  @db.Date
  accomplishments String?
  current_work    String?
  blockers        String?
  learning        String?
  support_needed  String?
  submitted_at    DateTime? @db.Timestamptz(3)
  reviewed_by     String?   @db.Uuid
  reviewed_at     DateTime? @db.Timestamptz(3)

  intern   Intern @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  reviewer User?  @relation(fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@unique([intern_id, week_start])
  @@map("weekly_checkins")
}

/// Dimension scores are 1–5 (CHECK constraint). No overall judgment is
/// computed or stored by the system.
model PerformanceReview {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String                  @db.Uuid
  intern_id           String                  @db.Uuid
  reviewer_id         String                  @db.Uuid
  review_period_start DateTime                @db.Date
  review_period_end   DateTime                @db.Date
  technical_skills    Int?
  communication       Int?
  ownership           Int?
  quality             Int?
  reliability         Int?
  teamwork            Int?
  learning            Int?
  problem_solving     Int?
  overall_comments    String?
  status              PerformanceReviewStatus @default(DRAFT)
  submitted_at        DateTime?               @db.Timestamptz(3)
  created_at          DateTime                @default(now()) @db.Timestamptz(3)
  updated_at          DateTime                @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern       Intern       @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  reviewer     User         @relation(fields: [reviewer_id], references: [id], onDelete: Restrict)

  @@index([organization_id, status])
  @@index([intern_id])
  @@index([reviewer_id])
  @@map("performance_reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNICATION
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String               @db.Uuid
  title           String
  body            String
  priority        AnnouncementPriority @default(NORMAL)
  published_by    String?              @db.Uuid
  published_at    DateTime?            @db.Timestamptz(3)
  expires_at      DateTime?            @db.Timestamptz(3)
  created_at      DateTime             @default(now()) @db.Timestamptz(3)
  updated_at      DateTime             @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  publisher    User?        @relation(fields: [published_by], references: [id], onDelete: SetNull)

  @@index([organization_id, published_at])
  @@map("announcements")
}

model Notification {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String    @db.Uuid
  user_id             String    @db.Uuid
  type                String
  title               String
  body                String?
  read_at             DateTime? @db.Timestamptz(3)
  related_entity_type String?
  related_entity_id   String?   @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([user_id, read_at])
  @@index([created_at])
  @@map("notifications")
}

model Channel {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String      @db.Uuid
  name            String
  slug            String
  description     String?
  channel_type    ChannelType @default(GENERAL)
  created_by      String?     @db.Uuid
  created_at      DateTime    @default(now()) @db.Timestamptz(3)
  updated_at      DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  creator      User?        @relation(fields: [created_by], references: [id], onDelete: SetNull)
  messages     Message[]

  @@unique([organization_id, slug])
  @@map("channels")
}

model Message {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel_id String    @db.Uuid
  sender_id  String    @db.Uuid
  body       String
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at DateTime? @db.Timestamptz(3)

  channel Channel @relation(fields: [channel_id], references: [id], onDelete: Restrict)
  sender  User    @relation(fields: [sender_id], references: [id], onDelete: Restrict)

  @@index([channel_id, created_at])
  @@index([sender_id])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// CERTIFICATES
// ─────────────────────────────────────────────────────────────────────────────

model Certificate {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String            @db.Uuid
  intern_id          String            @db.Uuid
  internship_id      String?           @db.Uuid
  certificate_number String            @unique
  certificate_type   CertificateType   @default(COMPLETION)
  issued_at          DateTime?         @db.Timestamptz(3)
  file_path          String?
  status             CertificateStatus @default(DRAFT)
  created_at         DateTime          @default(now()) @db.Timestamptz(3)
  updated_at         DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  organization  Organization              @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern        Intern                    @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  internship    Internship?               @relation(fields: [internship_id], references: [id], onDelete: Restrict)
  verifications CertificateVerification[]

  @@index([organization_id, status])
  @@index([intern_id])
  @@map("certificates")
}

model CertificateVerification {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificate_id     String    @db.Uuid
  verification_code  String    @unique
  verification_count Int       @default(0)
  last_verified_at   DateTime? @db.Timestamptz(3)
  created_at         DateTime  @default(now()) @db.Timestamptz(3)

  certificate Certificate @relation(fields: [certificate_id], references: [id], onDelete: Restrict)

  @@index([certificate_id])
  @@map("certificate_verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI & KNOWLEDGE (pipeline implemented in Prompt 07)
// ─────────────────────────────────────────────────────────────────────────────

model AiConversation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  title           String?
  context_type    String?
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages     AiMessage[]

  @@index([organization_id])
  @@index([user_id, updated_at])
  @@map("ai_conversations")
}

model AiMessage {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  role            AiMessageRole
  content         String
  model           String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)

  conversation AiConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@map("ai_messages")
}

model KnowledgeDocument {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String                  @db.Uuid
  title           String
  description     String?
  file_name       String
  storage_path    String
  mime_type       String
  status          KnowledgeDocumentStatus @default(PENDING)
  uploaded_by     String?                 @db.Uuid
  created_at      DateTime                @default(now()) @db.Timestamptz(3)
  updated_at      DateTime                @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  uploader     User?        @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@map("knowledge_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// SYSTEM
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only audit trail. Rows survive user deletion (actor set to NULL).
model AuditLog {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String      @db.Uuid
  actor_user_id   String?     @db.Uuid
  action          String
  resource_type   String
  resource_id     String?
  metadata        Json?
  ip_address      String?
  user_agent      String?
  status          AuditStatus @default(SUCCESS)
  created_at      DateTime    @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at(sort: Desc)])
  @@index([actor_user_id])
  @@index([resource_type, resource_id])
  @@index([organization_id, action])
  @@map("audit_logs")
}

/// Non-secret organization settings. Secrets belong in environment variables.
model Setting {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  key             String
  value           Json
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, key])
  @@map("settings")
}

/// One onboarding instance per internship (database-enforced). Its items are
/// copied from a template at generation time and never re-linked afterwards.
model Onboarding {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  internship_id   String    @unique @db.Uuid
  template_id     String?   @db.Uuid
  template_name   String
  started_at      DateTime  @default(now()) @db.Timestamptz(3)
  completed_at    DateTime? @db.Timestamptz(3)
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  internship   Internship          @relation(fields: [internship_id], references: [id], onDelete: Cascade)
  template     OnboardingTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  creator      User?               @relation(fields: [created_by], references: [id], onDelete: SetNull)
  items        OnboardingItem[]

  @@index([organization_id, completed_at])
  @@map("onboardings")
}

model OnboardingTemplate {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  name            String
  description     String?
  department_id   String?   @db.Uuid
  position_id     String?   @db.Uuid
  is_active       Boolean   @default(true)
  /// Used when no department/position-specific template matches.
  is_default      Boolean   @default(false)
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at      DateTime? @db.Timestamptz(3)

  organization Organization             @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  department   Department?              @relation(fields: [department_id], references: [id], onDelete: SetNull)
  position     Position?                @relation(fields: [position_id], references: [id], onDelete: SetNull)
  creator      User?                    @relation(fields: [created_by], references: [id], onDelete: SetNull)
  items        OnboardingTemplateItem[]
  onboardings  Onboarding[]

  @@unique([organization_id, name])
  @@index([organization_id, is_active])
  @@map("onboarding_templates")
}

model OnboardingTemplateItem {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id            String                 @db.Uuid
  title                  String
  description            String?
  category               OnboardingItemType     @default(TASK)
  required               Boolean                @default(true)
  due_days_after_start   Int                    @default(0)
  assigned_role          OnboardingAssigneeRole @default(INTERN)
  assigned_user_id       String?                @db.Uuid
  required_document_type DocumentType?
  policy_id              String?                @db.Uuid
  sort_order             Int                    @default(0)
  created_at             DateTime               @default(now()) @db.Timestamptz(3)
  updated_at             DateTime               @default(now()) @updatedAt @db.Timestamptz(3)

  template         OnboardingTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  assigned_user    User?              @relation(fields: [assigned_user_id], references: [id], onDelete: SetNull)
  policy           Policy?            @relation(fields: [policy_id], references: [id], onDelete: SetNull)
  onboarding_items OnboardingItem[]

  @@index([template_id, sort_order])
  @@map("onboarding_template_items")
}

/// Versioned policy/handbook text that people acknowledge.
model Policy {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  slug            String
  title           String
  version         Int      @default(1)
  body            String
  is_active       Boolean  @default(true)
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization     Organization              @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  creator          User?                     @relation(fields: [created_by], references: [id], onDelete: SetNull)
  acknowledgements DocumentAcknowledgement[]
  template_items   OnboardingTemplateItem[]
  onboarding_items OnboardingItem[]

  @@unique([organization_id, slug, version])
  @@map("policies")
}

/// Who acknowledged which version of a policy, and when.
model DocumentAcknowledgement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  policy_id       String   @db.Uuid
  policy_version  Int
  acknowledged_at DateTime @default(now()) @db.Timestamptz(3)
  ip_address      String?
  user_agent      String?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Restrict)
  policy       Policy       @relation(fields: [policy_id], references: [id], onDelete: Restrict)

  @@unique([user_id, policy_id, policy_version])
  @@index([organization_id])
  @@map("document_acknowledgements")
}

/// Internship history. idempotency_key prevents duplicate automated events.
model InternLifecycleEvent {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String             @db.Uuid
  intern_id       String             @db.Uuid
  event_type      LifecycleEventType
  description     String
  actor_user_id   String?            @db.Uuid
  metadata        Json?
  idempotency_key String?            @unique
  created_at      DateTime           @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  intern       Intern       @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([intern_id, created_at])
  @@index([organization_id, event_type])
  @@map("intern_lifecycle_events")
}

/// Per-organization counters for human-readable codes (e.g. AYV-INT-0001).
/// Incremented atomically, so concurrent creations never collide.
model CodeCounter {
  organization_id String   @db.Uuid
  key             String
  value           Int
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@id([organization_id, key])
  @@map("code_counters")
}
